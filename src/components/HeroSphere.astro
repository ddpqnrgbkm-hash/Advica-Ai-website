---
/** Animated 3D network sphere (decorative). */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={cls || 'relative'} aria-hidden="true">
  <div class="absolute inset-[12%] rounded-full bg-brand/30 blur-[90px]"></div>
  <div class="absolute inset-[30%] rounded-full bg-sky/20 blur-[60px]"></div>
  <canvas data-sphere class="sphere-canvas relative block size-full"></canvas>
</div>

<script>
  import { initSphere } from '../scripts/sphere';
  // Start after the page has loaded and the browser is idle, so text and buttons appear first
  const boot = () => document.querySelectorAll<HTMLCanvasElement>('canvas[data-sphere]').forEach(initSphere);
  const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 200));
  if (document.readyState === 'complete') idle(boot);
  else addEventListener('load', () => idle(boot), { once: true });
</script>

<style>
  .sphere-canvas { animation: sphere-in 1.2s ease-out both; }
  @keyframes sphere-in { from { opacity: 0; transform: scale(0.94); } }
</style>
