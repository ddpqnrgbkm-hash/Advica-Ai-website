---
/** FAQ list using <details>/<summary>, so every answer is in the page HTML for Google and screen readers. */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq border-t border-line">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p class="answer">{item.a}</p>
    </details>
  ))}
</div>
