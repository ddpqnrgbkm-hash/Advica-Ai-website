---
import { site } from '../config/site';
import BookButton from './BookButton.astro';
---
<!-- Sticky call and booking bar, mobile only -->
<div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-white px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 lg:hidden">
  <div class="mx-auto flex max-w-md gap-3">
    <a href={`tel:${site.phoneLink}`} class="btn-secondary flex-1 !min-h-11 !px-3">Call us</a>
    <BookButton class="btn-primary flex-1 !min-h-11 !px-3" />
  </div>
</div>
