---
import { site, bookingHref, bookingIsExternal } from '../config/site';
---
<!-- Sticky call/book bar, mobile only -->
<div class="fixed inset-x-0 bottom-0 z-30 border-t border-white/10 bg-ink/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur lg:hidden on-dark">
  <div class="mx-auto flex max-w-md gap-3">
    <a href={`tel:${site.phoneLink}`} class="btn flex-1 border border-white/25 !min-h-11 text-white">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" stroke-linejoin="round"/></svg>
      Call us
    </a>
    <a href={bookingHref} class="btn flex-1 bg-sky !min-h-11 text-ink hover:bg-white" {...(bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {})}>
      Book a call
    </a>
  </div>
</div>
