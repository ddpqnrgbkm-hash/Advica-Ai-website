---
import { site, bookingHref, bookingIsExternal } from '../config/site';
---
<!-- Sticky call/book bar, mobile only -->
<div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-white px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 lg:hidden">
  <div class="mx-auto flex max-w-md gap-3">
    <a href={`tel:${site.phoneLink}`} class="btn-secondary flex-1 !min-h-11">Call us</a>
    <a href={bookingHref} class="btn-primary flex-1 !min-h-11" {...(bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {})}>Book a call</a>
  </div>
</div>
