---
/** The Advica AI Solutions logo. Replace public/logo.png with the original high-resolution file when available. */
interface Props { size?: 'sm' | 'md' }
const { size = 'md' } = Astro.props;
---
<img src="/logo.png" alt="Advica AI Solutions" width="588" height="200" class:list={['w-auto', size === 'sm' ? 'h-9' : 'h-11']} />
