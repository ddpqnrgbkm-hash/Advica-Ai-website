---
/**
 * Logo: the sky-blue "A" mark plus "ADVICA AI" in heavy capitals, as on the current website.
 * Replace public/logo-mark.png with a high-resolution file when you have one.
 */
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<span class="inline-flex items-center gap-2.5">
  <img src="/logo-mark.png" alt="" width="30" height="34" class="h-[34px] w-auto" />
  <span class:list={['text-lg font-black uppercase leading-none tracking-tight', dark ? 'text-white' : 'text-ink']}>
    Advica <span class={dark ? 'text-cyan' : 'text-blue'}>AI</span>
  </span>
</span>
