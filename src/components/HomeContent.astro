---
import { getCollection } from 'astro:content';
import BookButton from './BookButton.astro';
import FAQ from './FAQ.astro';
import { site, partner, stats, testimonials } from '../config/site';
import { homeFaqs } from '../data/home';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries', (i) => i.data.show)).sort((a, b) => a.data.order - b.data.order);
const caseStudies = (await getCollection('caseStudies', (c) => !c.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 2);

const steps = [
  { name: 'Free call', text: 'You tell us what you want to improve. We ask questions and tell you honestly whether we can help.' },
  { name: 'Plan and quote', text: 'We look at how you work today, then send you a written plan with a timeline and a quote.' },
  { name: 'Build', text: 'We build in small stages and show you each one, so you can give feedback as we go.' },
  { name: 'Ongoing support or handover', text: 'Once it is live, we look after it for you, or hand it over to your own team with training.' },
];

---
<!-- ================= Intro ================= -->
<section class="border-b border-line">
  <div class="container-x grid gap-12 py-14 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
    <div>
      <h1 class="text-[2.5rem] sm:text-[3.4rem]">Custom software and AI tools for UK businesses</h1>
      <p class="mt-6 max-w-xl text-xl text-muted">We build software that fits the way your business works, so your team spends less time on admin and makes fewer mistakes. You get a written plan and quote before any work starts.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <BookButton />
        <a href="/estimate" class="btn-secondary">Estimate your project cost</a>
      </div>
      {partner.show && <p class="mt-8 text-[0.95rem] text-muted">{partner.statement}{partner.name && `: ${partner.name}`}.</p>}
    </div>
    <div class="photo-placeholder aspect-[4/3] w-full" role="img" aria-label="Photo placeholder">[Photo: you or your team with a client. Real photo needed.]</div>
  </div>
</section>

{stats.length > 0 && (
  <section class="border-b border-line py-10">
    <dl class="container-x grid gap-8 sm:grid-cols-3">
      {stats.map((s) => <div><dt class="text-muted">{s.label}</dt><dd class="font-heading text-4xl">{s.value}</dd></div>)}
    </dl>
  </section>
)}

<!-- ================= Services ================= -->
<section class="py-16 sm:py-24" aria-labelledby="services-h">
  <div class="container-x">
    <h2 id="services-h" class="text-3xl sm:text-4xl">What we do</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">Most clients come to us for one of these four things. Many projects use more than one.</p>
    <ul class="mt-10 grid gap-x-16 border-t border-line md:grid-cols-2">
      {services.map((s) => (
        <li class="border-b border-line py-8">
          <h3 class="text-2xl">{s.data.title}</h3>
          <p class="mt-3 text-muted">{s.data.summary}</p>
          <a href={`/services/${s.id}`} class="link mt-4 inline-block">More about {s.data.title.startsWith('AI') ? s.data.title : s.data.title.charAt(0).toLowerCase() + s.data.title.slice(1)}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ================= Who we work with ================= -->
<section class="bg-soft py-16 sm:py-24" aria-labelledby="who-h">
  <div class="container-x grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 id="who-h" class="text-3xl sm:text-4xl">Who we work with</h2>
      <p class="mt-5 text-lg">Most of our clients are business owners and managers. They know what they want to improve, but they don't have a technical team, or their team is already busy.</p>
      <p class="mt-4 text-lg">We work with businesses across the UK, from growing firms to larger organisations.</p>
      <a href="/industries" class="link mt-6 inline-block">Industries we work in</a>
    </div>
    <ul class="grid content-start gap-px border border-line bg-line sm:grid-cols-2">
      {industries.map((i) => (
        <li class="bg-white p-5">
          <span class="block font-semibold">{i.data.title}</span>
          <span class="mt-1 block text-[0.95rem] text-muted">{i.data.summary}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ================= How it works ================= -->
<section class="py-16 sm:py-24" aria-labelledby="how-h">
  <div class="container-x">
    <h2 id="how-h" class="text-3xl sm:text-4xl">How it works</h2>
    <ol class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {steps.map((s, i) => (
        <li>
          <span class="font-heading text-4xl text-brand">{i + 1}</span>
          <h3 class="mt-2 text-xl">{s.name}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
    <a href="/how-it-works" class="link mt-10 inline-block">More about how we work</a>
  </div>
</section>

<!-- ================= Proof ================= -->
<section class="border-t border-line py-16 sm:py-24" aria-labelledby="proof-h">
  <div class="container-x">
    <h2 id="proof-h" class="text-3xl sm:text-4xl">What our clients say</h2>
    <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-16">
      {testimonials.map((t) => (
        <figure class="border-l-4 border-brand pl-6">
          <blockquote class="text-xl">“{t.quote}”</blockquote>
          <figcaption class="mt-4 text-muted">
            {t.name ? <><strong class="text-ink">{t.name}</strong>, {t.role}, {t.company}</> : '[PLACEHOLDER: name, role, company]'}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-16 grid gap-6 border-t border-line pt-10 lg:grid-cols-[1fr_2fr]">
      <h3 class="text-2xl">Case studies</h3>
      {caseStudies.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2">
          {caseStudies.map((c) => (
            <li><a href={`/case-studies/${c.id}`} class="group block"><span class="text-sm text-muted">{c.data.industry}</span><span class="mt-1 block text-lg font-semibold group-hover:text-brand group-hover:underline">{c.data.title}</span></a></li>
          ))}
        </ul>
      ) : (
        <p class="text-muted">We are writing up recent projects with our clients' permission, and they will appear here. If you would like to hear about work similar to yours, <a href="/contact" class="link">ask us</a>.</p>
      )}
    </div>
  </div>
</section>

<!-- ================= What happens when you get in touch ================= -->
<section class="bg-soft py-16 sm:py-24" aria-labelledby="next-h">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <h2 id="next-h" class="text-3xl sm:text-4xl">What happens when you get in touch</h2>
    <ol class="space-y-6">
      <li class="grid grid-cols-[2.5rem_1fr]"><span class="font-heading text-2xl text-brand">1</span><p>You book a call online, ring us on {site.phone} or send us a message.</p></li>
      <li class="grid grid-cols-[2.5rem_1fr]"><span class="font-heading text-2xl text-brand">2</span><p>We reply within [PLACEHOLDER: e.g. one working day] to arrange a time to talk.</p></li>
      <li class="grid grid-cols-[2.5rem_1fr]"><span class="font-heading text-2xl text-brand">3</span><p>On the call, we ask about your business and what you want to improve. The call is free and there is no obligation.</p></li>
      <li class="grid grid-cols-[2.5rem_1fr]"><span class="font-heading text-2xl text-brand">4</span><p>If we can help, we send you a written plan and quote. If we can't, we will tell you.</p></li>
    </ol>
  </div>
</section>

<!-- ================= FAQ ================= -->
<section class="py-16 sm:py-24" aria-labelledby="faq-h">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <h2 id="faq-h" class="text-3xl sm:text-4xl">Questions we are often asked</h2>
    <FAQ items={homeFaqs} />
  </div>
</section>

<!-- ================= Final call to action ================= -->
<section class="on-dark bg-dark py-16 sm:py-20">
  <div class="container-x flex flex-col justify-between gap-8 lg:flex-row lg:items-center">
    <div>
      <h2 class="text-3xl text-white sm:text-4xl">Talk to us about your project</h2>
      <p class="mt-3 max-w-xl text-lg text-on-dark">Book a free call to talk it through. You can also ring us on {site.phone}.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <BookButton class="btn-light" />
      <a href={`tel:${site.phoneLink}`} class="btn-secondary">Call {site.phone}</a>
    </div>
  </div>
</section>
