---
/** Dark header block used at the top of every inner page, with breadcrumb trail. */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: { label: string; href?: string }[];
  accent?: 'sky' | 'lime' | 'lilac';
}
const { eyebrow, title, intro, crumbs = [], accent = 'sky' } = Astro.props;
const glow = { sky: 'bg-brand/50', lime: 'bg-lime/25', lilac: 'bg-lilac/35' }[accent];
---
<section class="on-dark relative overflow-hidden bg-ink text-white">
  <div aria-hidden="true" class:list={['pointer-events-none absolute -right-40 -top-40 size-[36rem] rounded-full blur-[130px]', glow]}></div>
  <div class="container-x relative pb-16 pt-12 sm:pb-24 sm:pt-16">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-10 text-sm text-mist">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-white">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span aria-current="page" class="text-white">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-5 max-w-4xl text-4xl font-bold leading-[1.02] sm:text-6xl lg:text-7xl">{title}</h1>
    {intro && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/75 sm:text-xl">{intro}</p>}
    <slot />
  </div>
</section>
