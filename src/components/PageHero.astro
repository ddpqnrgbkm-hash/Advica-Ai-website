---
/** Cinematic header block used at the top of every inner page, with breadcrumb trail. */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: { label: string; href?: string }[];
  accent?: 'sky' | 'lime' | 'lilac';
}
const { eyebrow, title, intro, crumbs = [], accent = 'sky' } = Astro.props;
const glow = { sky: 'bg-deep/60', lime: 'bg-brand/35', lilac: 'bg-[#3b4fd6]/40' }[accent];
---
<section class="on-dark relative isolate overflow-hidden border-b border-white/[0.06]">
  <div aria-hidden="true" class="grid-bg absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_80%_70%_at_70%_0%,#000,transparent)]"></div>
  <div aria-hidden="true" class:list={['absolute -right-40 -top-56 -z-10 h-[34rem] w-[50rem] rounded-full blur-[130px]', glow]}></div>
  <div aria-hidden="true" class="absolute -left-40 bottom-0 -z-10 h-64 w-[30rem] rounded-full bg-sky/10 blur-[120px]"></div>
  <!-- Decorative orbit rings (CSS only) -->
  <div aria-hidden="true" class="orbits pointer-events-none absolute -right-24 top-1/2 -z-10 hidden size-[36rem] -translate-y-1/2 lg:block">
    <span class="ring r1"><i></i></span><span class="ring r2"><i></i></span><span class="ring r3"><i></i></span>
    <span class="core"></span>
  </div>
  <div class="container-x relative pb-16 pt-10 sm:pb-24 sm:pt-14">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-12 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-white/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-sky">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-sky">/</span>
              {c.href ? <a href={c.href} class="hover:text-sky">{c.label}</a> : <span aria-current="page" class="text-white">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow"><span class="size-1.5 rounded-full bg-sky shadow-[0_0_12px_3px_rgba(60,200,255,0.7)]"></span>{eyebrow}</p>}
    <h1 class="mt-6 max-w-4xl text-[2.6rem] font-semibold leading-[1.03] tracking-[-0.035em] text-white sm:text-6xl lg:text-7xl">{title}</h1>
    {intro && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-mist sm:text-xl">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .orbits { perspective: 900px; }
  .ring { position: absolute; inset: 0; border-radius: 9999px; border: 1px solid rgb(60 200 255 / 0.1); transform: rotateX(68deg); animation: spin 26s linear infinite; }
  .r2 { inset: 13%; border-color: rgb(47 123 255 / 0.16); animation-duration: 19s; animation-direction: reverse; }
  .r3 { inset: 27%; border-color: rgb(60 200 255 / 0.2); animation-duration: 14s; }
  .ring i { position: absolute; top: -4px; left: 50%; width: 8px; height: 8px; border-radius: 9999px; background: #bfeaff; box-shadow: 0 0 16px 4px rgb(60 200 255 / 0.8); }
  .core { position: absolute; inset: 41%; border-radius: 9999px; background: radial-gradient(circle at 35% 35%, #bfeaff, #3cc8ff 30%, #2f7bff 60%, transparent 72%); filter: blur(1px); box-shadow: 0 0 80px 20px rgb(60 200 255 / 0.25); opacity: 0.85; }
  @keyframes spin { to { transform: rotateX(68deg) rotateZ(360deg); } }
</style>
