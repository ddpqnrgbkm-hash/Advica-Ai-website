---
import Logo from './Logo.astro';
import BookButton from './BookButton.astro';
import { nav, site } from '../config/site';
const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.name} — home`}><Logo /></a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['rounded-full px-4 py-2 text-[0.95rem] font-medium transition-colors hover:bg-ink/5',
                isActive(item.href) ? 'text-brand' : 'text-ink/80']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={`tel:${site.phoneLink}`} class="text-sm font-medium text-ink/70 hover:text-ink">{site.phone}</a>
      <BookButton class="btn-primary !min-h-11 !px-5" />
    </div>

    <!-- Mobile menu: works without JavaScript -->
    <details class="group relative lg:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-white [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
        <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 top-[4.5rem] border-b border-line bg-paper px-5 pb-8 pt-4 shadow-xl">
        <ul class="divide-y divide-line">
          {nav.map((item) => (
            <li><a href={item.href} class="block py-4 font-display text-xl font-semibold">{item.label}</a></li>
          ))}
          <li><a href="/contact" class="block py-4 font-display text-xl font-semibold">Contact</a></li>
        </ul>
        <BookButton class="btn-primary mt-6 w-full" />
      </nav>
    </details>
  </div>
</header>
