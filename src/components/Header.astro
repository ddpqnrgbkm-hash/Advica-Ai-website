---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import BookButton from './BookButton.astro';
import { nav, site } from '../config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b border-line bg-white">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.name} home`}><Logo /></a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li class:list={['relative', item.dropdown && 'has-menu']}>
            {item.dropdown ? (
              <>
                <button type="button" class="nav-trigger flex items-center gap-1.5 px-3 py-2 font-semibold text-ink hover:text-brand" aria-expanded="false" aria-controls="menu-services">
                  {item.label}
                  <svg class="chev size-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </button>
                <div id="menu-services" class="nav-panel">
                  <ul class="py-2">
                    {services.map((s) => (
                      <li>
                        <a href={`/services/${s.id}`} class="block px-5 py-3 hover:bg-soft">
                          <span class="block font-semibold">{s.data.title}</span>
                          <span class="block text-[0.95rem] leading-snug text-muted">{s.data.summary.split('. ')[0]}.</span>
                        </a>
                      </li>
                    ))}
                    <li class="mt-1 border-t border-line"><a href="/services" class="block px-5 py-3 font-semibold text-brand hover:underline">All services</a></li>
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class:list={['block px-3 py-2 font-semibold hover:text-brand', isActive(item.href) ? 'text-brand' : 'text-ink']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={`tel:${site.phoneLink}`} class="font-semibold text-ink hover:text-brand">{site.phone}</a>
      <BookButton class="btn-primary !min-h-11" />
    </div>

    <!-- Mobile menu (works without JavaScript) -->
    <details class="group lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 font-semibold [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
      </summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 bottom-0 top-[4.5rem] overflow-y-auto bg-white px-5 pb-32 pt-4">
        <ul class="divide-y divide-line border-b border-line">
          <li class="py-3">
            <a href="/services" class="text-xl font-semibold">Services</a>
            <ul class="mt-2 space-y-2 pl-3">
              {services.map((s) => <li><a href={`/services/${s.id}`} class="text-muted">{s.data.title}</a></li>)}
            </ul>
          </li>
          {nav.filter((n) => !n.dropdown).map((item) => <li><a href={item.href} class="block py-3 text-xl font-semibold">{item.label}</a></li>)}
          <li><a href="/contact" class="block py-3 text-xl font-semibold">Contact</a></li>
        </ul>
        <BookButton class="btn-primary mt-6 w-full" />
      </nav>
    </details>
  </div>
</header>

<style>
  .nav-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    width: 24rem;
    display: none;
    background: #fff;
    border: 1px solid var(--c-line);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.2);
  }
  .nav-panel::before { content: ''; position: absolute; inset: -0.6rem 0 auto 0; height: 0.6rem; }
  @media (hover: hover) {
    .has-menu:not([data-suppress]):hover > .nav-panel { display: block; }
    .has-menu:not([data-suppress]):hover .chev { transform: rotate(180deg); }
  }
  .has-menu[data-open] > .nav-panel { display: block; }
  .has-menu[data-open] .chev { transform: rotate(180deg); }
</style>

<script>
  const li = document.querySelector<HTMLElement>('.has-menu');
  const btn = li?.querySelector<HTMLButtonElement>('.nav-trigger');
  if (li && btn) {
    const close = () => { li.removeAttribute('data-open'); btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', () => {
      const open = !li.hasAttribute('data-open');
      li.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) close(); });
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); li.setAttribute('data-suppress', ''); btn.focus(); } });
    li.addEventListener('mouseleave', () => { li.removeAttribute('data-suppress'); close(); });
    document.addEventListener('click', (e) => { if (!li.contains(e.target as Node)) close(); });
  }
</script>
