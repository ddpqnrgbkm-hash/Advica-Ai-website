---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { nav, site } from '../config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const chevron = 'M6 9l6 6 6-6';
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-white">
  <div class="container-wide flex h-16 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.name} home`}><Logo /></a>

    <!-- ===== Desktop navigation ===== -->
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {nav.map((item, i) => {
          const cls = ['flex items-center gap-1 px-3 py-2 text-sm transition-colors hover:text-ink', isActive(item.href) ? 'text-ink' : 'text-ink/75'];
          return (
            <li class:list={['nav-item', item.dropdown && 'has-menu mega']}>
              {item.dropdown ? (
                <button type="button" class:list={['nav-trigger', ...cls]} aria-expanded="false" aria-controls={`menu-${i}`}>
                  {item.label}
                  <svg class="chev size-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={chevron} stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              ) : (
                <a href={item.href} class:list={cls} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              )}
              {item.dropdown && (
                <div id={`menu-${i}`} class="nav-panel">
                  <div class="container-x grid grid-cols-3 gap-x-10 gap-y-8 py-10">
                    {services.map((s) => (
                      <a href={`/services/${s.id}`} class="group block">
                        <span class="block text-xl font-semibold text-ink group-hover:text-blue">{s.data.title}</span>
                        <span class="mt-1 block text-sm text-muted">{s.data.menuText}</span>
                      </a>
                    ))}
                  </div>
                  <div class="border-t border-line">
                    <div class="container-x py-4"><a href="/services" class="more text-sm">See all services ›</a></div>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <a href="/contact" class="btn-primary hidden !min-h-9 !px-4 !text-sm lg:inline-flex">Talk to us</a>

    <!-- ===== Mobile menu (works without JavaScript) ===== -->
    <details class="mobile-menu group lg:hidden">
      <summary class="flex size-10 cursor-pointer list-none items-center justify-center text-ink [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Menu</span>
        <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke-linecap="round" /></svg>
        <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
      </summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 bottom-0 top-16 overflow-y-auto bg-white px-8 pb-32 pt-6">
        <ul class="space-y-1">
          {nav.map((item) => (
            <li>
              {item.dropdown ? (
                <details class="group/sub">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-[1.75rem] font-semibold tracking-tight text-ink [&::-webkit-details-marker]:hidden">
                    {item.label}
                    <svg class="size-5 transition-transform group-open/sub:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={chevron} /></svg>
                  </summary>
                  <ul class="space-y-2 pb-4 pl-1 pt-2">
                    {services.map((s) => <li><a href={`/services/${s.id}`} class="block text-lg text-ink/80">{s.data.title}</a></li>)}
                    <li><a href="/services" class="block text-lg text-blue">All services</a></li>
                  </ul>
                </details>
              ) : (
                <a href={item.href} class="block py-2 text-[1.75rem] font-semibold tracking-tight text-ink">{item.label}</a>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-10 text-muted">{site.phone}<br />{site.email}</p>
      </nav>
    </details>
  </div>
</header>

<style>
  .nav-item { position: relative; }
  .mega { position: static; }
  .nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: none;
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 30px 40px -30px rgb(0 0 0 / 0.15);
  }
  @media (hover: hover) {
    .has-menu:not([data-suppress]):hover > .nav-panel { display: block; }
    .has-menu:not([data-suppress]):hover .chev { transform: rotate(180deg); }
  }
  .has-menu[data-open] > .nav-panel { display: block; }
  .has-menu[data-open] .chev { transform: rotate(180deg); }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.has-menu');
  const close = (li: HTMLElement) => {
    li.removeAttribute('data-open');
    li.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
  };
  items.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.nav-trigger')!;
    btn.addEventListener('click', () => {
      const open = li.hasAttribute('data-open');
      items.forEach(close);
      if (!open) { li.setAttribute('data-open', ''); btn.setAttribute('aria-expanded', 'true'); }
    });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) close(li); });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { close(li); li.setAttribute('data-suppress', ''); btn.focus(); }
    });
    li.addEventListener('mouseleave', () => { li.removeAttribute('data-suppress'); close(li); });
  });
  document.addEventListener('click', (e) => { items.forEach((li) => { if (!li.contains(e.target as Node)) close(li); }); });
</script>
