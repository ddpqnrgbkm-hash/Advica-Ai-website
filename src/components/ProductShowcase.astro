---
/**
 * "What we build" - tabbed glass browser window with an illustrative product screen per service.
 * Screens are built in HTML/CSS (no images) and are clearly labelled as examples.
 */
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const chip = 'rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 font-mono text-[0.68rem] text-mist';
---
<div data-tabs class="reveal">
  <div role="tablist" aria-label="What we build" hidden class="mx-auto flex w-fit max-w-full gap-1 overflow-x-auto rounded-full border border-white/10 bg-white/[0.03] p-1.5">
    {services.map((s) => (
      <button
        type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected="false"
        class="shrink-0 rounded-full px-5 py-2.5 text-sm font-medium text-mist transition hover:text-white aria-selected:bg-sky aria-selected:text-void aria-selected:shadow-[0_0_30px_-5px_rgba(60,200,255,0.7)] sm:px-7"
      >{s.data.title}</button>
    ))}
  </div>

  {services.map((s) => (
    <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" class="mt-10 grid items-center gap-10 lg:grid-cols-[0.85fr_1.4fr] lg:gap-14">
      <!-- Copy -->
      <div>
        <h3 class="text-3xl font-semibold leading-tight text-white sm:text-4xl">{s.data.headline}</h3>
        <p class="mt-5 text-lg leading-relaxed text-mist">{s.data.summary}</p>
        <ul class="mt-7 grid gap-2.5 sm:grid-cols-2">
          {s.data.capabilities.slice(0, 6).map((c) => (
            <li>
              <a href={`/services/${s.id}#${c.id}`} class="group flex items-center gap-2.5 text-sm text-white/85 hover:text-sky">
                <span class="size-1.5 shrink-0 rounded-full bg-sky shadow-[0_0_10px_2px_rgba(60,200,255,0.6)]"></span>
                {c.name.split(' (')[0]}
              </a>
            </li>
          ))}
        </ul>
        <a href={`/services/${s.id}`} class="btn-secondary mt-9">Explore {s.data.title} <span aria-hidden="true">→</span></a>
      </div>

      <!-- Mock-up window -->
      <figure class="relative">
        <div aria-hidden="true" class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-brand/30 via-sky/10 to-transparent blur-2xl"></div>
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-ink-2/95 shadow-[0_40px_120px_-30px_rgba(0,0,0,0.9)]" aria-hidden="true">
          <div class="flex items-center gap-2 border-b border-white/[0.07] px-4 py-3">
            <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
            <span class="ml-3 rounded-md bg-white/[0.05] px-3 py-1 font-mono text-[0.68rem] text-mist">
              {s.id === 'ai-and-data' ? 'app.yourcompany.co.uk/assistant' : s.id === 'software-and-cloud' ? 'portal.yourcompany.co.uk/jobs' : 'board.yourcompany.co.uk/sprint-14'}
            </span>
          </div>

          {s.id === 'ai-and-data' && (
            <div class="grid gap-4 p-5 sm:grid-cols-[1fr_1.3fr]">
              <div class="space-y-2.5">
                <p class="font-mono text-[0.68rem] uppercase tracking-widest text-mist">Documents</p>
                {[['Supplier_quote_0412.pdf', 'Extracted'], ['Drawings_rev_C.pdf', 'Extracted'], ['Site_notes_voice.m4a', 'Processing…']].map(([n, st], i) => (
                  <div class:list={['flex items-center justify-between gap-3 rounded-xl border p-3', i === 0 ? 'border-sky/40 bg-sky/[0.07]' : 'border-white/[0.07] bg-white/[0.02]']}>
                    <span class="truncate text-xs text-white/85">{n}</span>
                    <span class:list={['shrink-0 rounded-full px-2 py-0.5 font-mono text-[0.62rem]', st === 'Extracted' ? 'bg-sky/15 text-sky' : 'bg-white/10 text-mist']}>{st}</span>
                  </div>
                ))}
                <div class="rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
                  <p class="text-[0.7rem] text-mist">You</p>
                  <p class="mt-1 text-xs text-white/90">Summarise this quote and flag anything over budget.</p>
                  <div class="mt-3 rounded-lg bg-brand/20 p-2.5">
                    <p class="text-[0.7rem] text-sky">Assistant</p>
                    <p class="mt-1 text-xs leading-relaxed text-white/90">12 line items found. Steel (item 7) is 14% above your target rate<span class="typing"></span></p>
                  </div>
                </div>
              </div>
              <div class="rounded-xl border border-white/[0.07] bg-white/[0.02] p-3">
                <div class="flex items-center justify-between">
                  <p class="font-mono text-[0.68rem] uppercase tracking-widest text-mist">Line items</p>
                  <span class={chip}>98% confidence</span>
                </div>
                <table class="mt-3 w-full text-left text-[0.72rem]">
                  <thead class="text-mist"><tr><th class="pb-2 font-normal">Item</th><th class="pb-2 font-normal">Qty</th><th class="pb-2 text-right font-normal">Total</th></tr></thead>
                  <tbody class="text-white/85">
                    {[['Concrete C32/40', '42 m³', '£5,460'], ['Rebar B500B', '3.1 t', '£2,914'], ['Formwork hire', '6 wks', '£1,980'], ['Structural steel', '8.4 t', '£11,340'], ['Blockwork 140mm', '620 m²', '£4,216']].map(([a, b, c], i) => (
                      <tr class:list={['border-t border-white/[0.06]', i === 3 && 'text-sky']}><td class="py-2">{a}</td><td class="py-2">{b}</td><td class="py-2 text-right font-mono">{c}</td></tr>
                    ))}
                  </tbody>
                </table>
                <div class="mt-3 flex h-16 items-end gap-1.5" >
                  {[40, 62, 35, 90, 55, 70, 48, 80, 66].map((v, i) => <span class:list={['flex-1 rounded-t', i === 3 ? 'bg-sky' : 'bg-brand/50']} style={`height:${v}%`}></span>)}
                </div>
              </div>
            </div>
          )}

          {s.id === 'software-and-cloud' && (
            <div class="relative p-5">
              <div class="grid gap-3 sm:grid-cols-3">
                {[['Open jobs', '24'], ['Booked this week', '61'], ['Invoices due', '£18.4k']].map(([l, v]) => (
                  <div class="rounded-xl border border-white/[0.07] bg-white/[0.02] p-3"><p class="text-[0.7rem] text-mist">{l}</p><p class="mt-1 text-xl font-semibold text-white">{v}</p></div>
                ))}
              </div>
              <div class="mt-3 space-y-2 sm:pr-40">
                {[['Boiler service, 14 Mill Lane', 'Scheduled', 'sky'], ['Kitchen refit, Unit 3 Park Rd', 'In progress', 'brand'], ['Roof inspection, 2 Church St', 'Awaiting sign-off', 'mist'], ['Rewire, The Old Bakery', 'Completed', 'sky']].map(([j, st, c]) => (
                  <div class="flex items-center justify-between gap-3 rounded-xl border border-white/[0.07] bg-white/[0.02] px-3 py-2.5">
                    <span class="truncate text-xs text-white/85">{j}</span>
                    <span class:list={['shrink-0 rounded-full px-2 py-0.5 font-mono text-[0.62rem]', c === 'sky' ? 'bg-sky/15 text-sky' : c === 'brand' ? 'bg-brand/25 text-[#9cc0ff]' : 'bg-white/10 text-mist']}>{st}</span>
                  </div>
                ))}
              </div>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class={chip}>● Deployed to production · 2 min ago</span>
                <span class={chip}>Tests passed 212/212</span>
              </div>
              <!-- Phone -->
              <div class="absolute bottom-4 right-5 hidden w-36 rounded-[1.6rem] border border-white/15 bg-void p-2 shadow-[0_20px_60px_-10px_rgba(60,200,255,0.35)] sm:block">
                <div class="rounded-[1.2rem] bg-ink-3 p-2.5">
                  <p class="font-mono text-[0.55rem] text-mist">FIELD APP</p>
                  <p class="mt-1 text-[0.7rem] font-semibold text-white">Today’s jobs</p>
                  <div class="mt-2 h-14 rounded-lg bg-gradient-to-br from-brand/40 to-sky/20"></div>
                  <div class="mt-2 space-y-1.5">
                    <div class="h-1.5 rounded bg-white/20"></div><div class="h-1.5 w-3/4 rounded bg-white/10"></div>
                  </div>
                  <div class="mt-3 rounded-full bg-sky py-1 text-center text-[0.6rem] font-semibold text-void">Sign off job</div>
                </div>
              </div>
            </div>
          )}

          {s.id === 'extra-engineers' && (
            <div class="p-5">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm font-semibold text-white">Sprint 14 · Customer portal</p>
                <div class="flex -space-x-2">
                  {[['JS', 'bg-white/20'], ['AK', 'bg-white/20'], ['MR', 'bg-white/20'], ['DE', 'bg-sky text-void'], ['PN', 'bg-sky text-void']].map(([i, c]) => (
                    <span class:list={['grid size-7 place-items-center rounded-full border-2 border-ink-2 text-[0.6rem] font-semibold', c]}>{i}</span>
                  ))}
                </div>
              </div>
              <p class="mt-1 text-[0.7rem] text-mist"><span class="text-sky">●</span> 2 engineers added to your team this sprint</p>
              <div class="mt-4 grid grid-cols-3 gap-3">
                {[['To do', [['Payment webhooks', false], ['Audit log', false]]], ['In progress', [['Data pipeline', true], ['Login with SSO', false]]], ['Done', [['Search API', true], ['CI/CD pipeline', true], ['Dashboard', false]]]].map(([col, cards]) => (
                  <div class="rounded-xl bg-white/[0.02] p-2.5">
                    <p class="font-mono text-[0.62rem] uppercase tracking-widest text-mist">{col as string}</p>
                    <div class="mt-2 space-y-2">
                      {(cards as [string, boolean][]).map(([t, ours]) => (
                        <div class:list={['rounded-lg border p-2 text-[0.68rem]', ours ? 'border-sky/40 bg-sky/[0.07] text-white' : 'border-white/[0.07] bg-white/[0.03] text-white/80']}>
                          {t}
                          {ours && <span class="mt-1.5 block font-mono text-[0.56rem] text-sky">Advica engineer</span>}
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
        <figcaption class="mt-3 text-center font-mono text-[0.68rem] uppercase tracking-widest text-mist">Illustrative example</figcaption>
      </figure>
    </div>
  ))}
</div>

<style>
  .typing::after {
    content: '▍';
    margin-left: 2px;
    color: var(--color-sky);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
