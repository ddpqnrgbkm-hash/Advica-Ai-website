---
/**
 * "What we build": tabbed section with an illustrative product screen per service.
 * Screens are built in HTML/CSS (no images) and are clearly labelled as examples.
 */
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const chip = 'rounded-full bg-page px-2.5 py-1 text-[0.68rem] font-medium text-muted';
const pill = {
  good: 'bg-[#e3f6f8] text-teal-ink',
  mid: 'bg-[#e6eef8] text-mid',
  wait: 'bg-page text-muted',
};
---
<div data-tabs>
  <div role="tablist" aria-label="What we build" hidden class="mx-auto flex w-fit max-w-full flex-wrap justify-center gap-1 rounded-3xl border border-line bg-white p-1.5 shadow-sm sm:rounded-full">
    {services.map((s) => (
      <button
        type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected="false"
        class="shrink-0 rounded-full px-5 py-2.5 text-sm font-semibold text-muted transition hover:text-navy aria-selected:bg-navy aria-selected:text-white sm:px-7"
      >{s.data.title}</button>
    ))}
  </div>

  {services.map((s) => (
    <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" class="mt-12 grid items-center gap-10 lg:grid-cols-[0.85fr_1.4fr] lg:gap-16">
      <!-- Copy -->
      <div>
        <h3 class="text-3xl font-bold leading-tight sm:text-4xl">{s.data.headline}</h3>
        <p class="mt-5 text-lg leading-relaxed text-muted">{s.data.summary}</p>
        <ul class="mt-7 grid gap-2.5 sm:grid-cols-2">
          {s.data.capabilities.slice(0, 6).map((c) => (
            <li>
              <a href={`/services/${s.id}#${c.id}`} class="group flex items-start gap-2.5 text-sm font-medium text-navy hover:text-mid">
                <svg class="mt-0.5 size-4 shrink-0 text-teal-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {c.name.split(' (')[0]}
              </a>
            </li>
          ))}
        </ul>
        <a href={`/services/${s.id}`} class="btn-primary mt-9">Explore {s.data.title} <span aria-hidden="true">→</span></a>
      </div>

      <!-- Mock-up window -->
      <figure class="relative">
        <div aria-hidden="true" class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-br from-[#d9ecf7] via-[#e9f3f8] to-transparent"></div>
        <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-[0_40px_80px_-40px_rgba(20,36,73,0.45)]" aria-hidden="true">
          <div class="flex items-center gap-2 border-b border-line bg-page px-4 py-3">
            <span class="size-2.5 rounded-full bg-[#f2b8b5]"></span><span class="size-2.5 rounded-full bg-[#f5d9a8]"></span><span class="size-2.5 rounded-full bg-[#bfe3c4]"></span>
            <span class="ml-3 rounded-md border border-line bg-white px-3 py-1 text-[0.68rem] text-muted">
              {s.id === 'ai-and-data' ? 'app.yourcompany.co.uk/assistant' : s.id === 'software-and-cloud' ? 'portal.yourcompany.co.uk/jobs' : 'board.yourcompany.co.uk/sprint-14'}
            </span>
          </div>

          {s.id === 'ai-and-data' && (
            <div class="grid gap-4 p-5 sm:grid-cols-[1fr_1.3fr]">
              <div class="space-y-2.5">
                <p class="text-[0.68rem] font-semibold uppercase tracking-widest text-muted">Documents</p>
                {[['Supplier_quote_0412.pdf', 'Extracted', 'good'], ['Drawings_rev_C.pdf', 'Extracted', 'good'], ['Site_notes_voice.m4a', 'Processing', 'wait']].map(([n, st, k], i) => (
                  <div class:list={['flex items-center justify-between gap-3 rounded-xl border p-3', i === 0 ? 'border-mid/40 bg-[#f1f6fc]' : 'border-line']}>
                    <span class="truncate text-xs text-navy">{n}</span>
                    <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-[0.62rem] font-semibold', pill[k as keyof typeof pill]]}>{st}</span>
                  </div>
                ))}
                <div class="rounded-xl border border-line p-3">
                  <p class="text-[0.7rem] text-muted">You</p>
                  <p class="mt-1 text-xs text-navy">Summarise this quote and flag anything over budget.</p>
                  <div class="bg-brand-gradient mt-3 rounded-lg p-2.5 text-white">
                    <p class="text-[0.7rem] font-semibold text-[#8fe3ec]">Assistant</p>
                    <p class="mt-1 text-xs leading-relaxed">12 line items found. Steel (item 7) is 14% above your target rate.</p>
                  </div>
                </div>
              </div>
              <div class="rounded-xl border border-line p-3">
                <div class="flex items-center justify-between">
                  <p class="text-[0.68rem] font-semibold uppercase tracking-widest text-muted">Line items</p>
                  <span class={chip}>98% confidence</span>
                </div>
                <table class="mt-3 w-full text-left text-[0.72rem]">
                  <thead class="text-muted"><tr><th class="pb-2 font-medium">Item</th><th class="pb-2 font-medium">Qty</th><th class="pb-2 text-right font-medium">Total</th></tr></thead>
                  <tbody class="text-navy">
                    {[['Concrete C32/40', '42 m³', '£5,460'], ['Rebar B500B', '3.1 t', '£2,914'], ['Formwork hire', '6 wks', '£1,980'], ['Structural steel', '8.4 t', '£11,340'], ['Blockwork 140mm', '620 m²', '£4,216']].map(([a, b, c], i) => (
                      <tr class:list={['border-t border-line', i === 3 && 'bg-[#fdf1e7] font-semibold text-[#9a4a12]']}><td class="py-2 pl-1">{a}</td><td class="py-2">{b}</td><td class="py-2 pr-1 text-right tabular-nums">{c}</td></tr>
                    ))}
                  </tbody>
                </table>
                <div class="mt-3 flex h-16 items-end gap-1.5">
                  {[40, 62, 35, 90, 55, 70, 48, 80, 66].map((v, i) => <span class:list={['flex-1 rounded-t', i === 3 ? 'bg-navy' : 'bg-[#bfe0ee]']} style={`height:${v}%`}></span>)}
                </div>
              </div>
            </div>
          )}

          {s.id === 'software-and-cloud' && (
            <div class="relative p-5">
              <div class="grid gap-3 sm:grid-cols-3">
                {[['Open jobs', '24'], ['Booked this week', '61'], ['Invoices due', '£18.4k']].map(([l, v]) => (
                  <div class="rounded-xl border border-line p-3"><p class="text-[0.7rem] text-muted">{l}</p><p class="mt-1 font-display text-xl font-bold text-navy">{v}</p></div>
                ))}
              </div>
              <div class="mt-3 space-y-2 sm:pr-40">
                {[['Boiler service, 14 Mill Lane', 'Scheduled', 'mid'], ['Kitchen refit, Unit 3 Park Rd', 'In progress', 'mid'], ['Roof inspection, 2 Church St', 'Awaiting sign-off', 'wait'], ['Rewire, The Old Bakery', 'Completed', 'good']].map(([j, st, k]) => (
                  <div class="flex items-center justify-between gap-3 rounded-xl border border-line px-3 py-2.5">
                    <span class="truncate text-xs text-navy">{j}</span>
                    <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-[0.62rem] font-semibold', pill[k as keyof typeof pill]]}>{st}</span>
                  </div>
                ))}
              </div>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class={chip}>Deployed to production · 2 min ago</span>
                <span class={chip}>Tests passed 212/212</span>
              </div>
              <!-- Phone -->
              <div class="absolute bottom-4 right-5 hidden w-36 rounded-[1.6rem] border-4 border-navy-deep bg-navy-deep shadow-[0_25px_50px_-20px_rgba(20,36,73,0.6)] sm:block">
                <div class="rounded-[1.25rem] bg-white p-2.5">
                  <p class="text-[0.55rem] font-semibold uppercase tracking-wider text-muted">Field app</p>
                  <p class="mt-1 font-display text-[0.75rem] font-bold text-navy">Today’s jobs</p>
                  <div class="bg-brand-gradient mt-2 h-14 rounded-lg"></div>
                  <div class="mt-2 space-y-1.5"><div class="h-1.5 rounded bg-line"></div><div class="h-1.5 w-3/4 rounded bg-line"></div></div>
                  <div class="mt-3 rounded-full bg-navy py-1 text-center text-[0.6rem] font-semibold text-white">Sign off job</div>
                </div>
              </div>
            </div>
          )}

          {s.id === 'extra-engineers' && (
            <div class="p-5">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="font-display text-sm font-bold text-navy">Sprint 14 · Customer portal</p>
                <div class="flex -space-x-2">
                  {[['JS', 'bg-silver text-navy'], ['AK', 'bg-silver text-navy'], ['MR', 'bg-silver text-navy'], ['DE', 'bg-navy text-white'], ['PN', 'bg-navy text-white']].map(([i, c]) => (
                    <span class:list={['grid size-7 place-items-center rounded-full border-2 border-white text-[0.6rem] font-semibold', c]}>{i}</span>
                  ))}
                </div>
              </div>
              <p class="mt-1 text-[0.7rem] text-muted">2 engineers added to your team this sprint</p>
              <div class="mt-4 grid grid-cols-3 gap-3">
                {[['To do', [['Payment webhooks', false], ['Audit log', false]]], ['In progress', [['Data pipeline', true], ['Login with SSO', false]]], ['Done', [['Search API', true], ['CI/CD pipeline', true], ['Dashboard', false]]]].map(([col, cards]) => (
                  <div class="rounded-xl bg-page p-2.5">
                    <p class="text-[0.62rem] font-semibold uppercase tracking-widest text-muted">{col as string}</p>
                    <div class="mt-2 space-y-2">
                      {(cards as [string, boolean][]).map(([t, ours]) => (
                        <div class:list={['rounded-lg border bg-white p-2 text-[0.68rem] text-navy', ours ? 'border-mid/50' : 'border-line']}>
                          {t}
                          {ours && <span class="mt-1.5 block text-[0.56rem] font-semibold text-mid">Advica engineer</span>}
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
        <figcaption class="mt-4 text-center text-xs font-medium uppercase tracking-widest text-muted">Illustrative example</figcaption>
      </figure>
    </div>
  ))}
</div>
