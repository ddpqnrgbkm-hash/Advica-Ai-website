---
import BookButton from './BookButton.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Tell us what you want to fix. We’ll tell you honestly if we can help.',
  text = 'Book a free discovery call, or send us a few details and we’ll get back to you.',
} = Astro.props;
---
<section class="py-20 sm:py-28">
  <div class="container-x">
    <div class="on-dark bg-brand-gradient relative overflow-hidden rounded-[2rem] px-6 py-14 text-center sm:px-16 sm:py-20">
      <svg aria-hidden="true" class="absolute inset-0 size-full opacity-30" viewBox="0 0 1200 400" preserveAspectRatio="none" fill="none">
        <path d="M0 300 C 300 200, 500 380, 800 250 S 1100 150, 1200 200" stroke="#8fe3ec" stroke-width="1.2" />
        <path d="M0 340 C 350 260, 550 400, 850 290 S 1100 210, 1200 250" stroke="#8fe3ec" stroke-width="0.8" />
        <path d="M0 120 C 250 60, 600 180, 900 80 S 1150 40, 1200 70" stroke="#ffffff" stroke-width="0.8" />
      </svg>
      <div class="relative">
        <h2 class="mx-auto max-w-3xl text-3xl font-bold leading-tight text-white sm:text-5xl">{title}</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-white/85">{text}</p>
        <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
          <BookButton class="btn-light" label="Book a free call" />
          <a href="/contact" class="btn-secondary">Send an enquiry</a>
        </div>
      </div>
    </div>
  </div>
</section>
