---
import BookButton from './BookButton.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Tell us what you want to fix. We’ll tell you honestly if we can help.',
  text = 'Book a free discovery call, or send us a few details and we’ll get back to you.',
} = Astro.props;
---
<section class="on-dark relative overflow-hidden py-24 sm:py-32">
  <div aria-hidden="true" class="grid-bg pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,#000_20%,transparent_70%)]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 h-[30rem] w-[60rem] max-w-[140vw] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/25 blur-[120px]"></div>
  <div class="container-x relative">
    <div class="reveal glass mx-auto max-w-4xl px-6 py-14 text-center sm:px-16 sm:py-20">
      <p class="eyebrow justify-center">Start a conversation</p>
      <h2 class="mt-6 text-3xl font-semibold leading-tight text-white sm:text-5xl">{title}</h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-mist">{text}</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <BookButton class="btn-primary" label="Book a free call" />
        <a href="/contact" class="btn-secondary">Send an enquiry</a>
      </div>
    </div>
  </div>
</section>
