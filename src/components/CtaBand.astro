---
import { site } from '../config/site';
interface Props { title?: string; text?: string }
const {
  title = 'Let’s talk about your project.',
  text = 'Tell us what you’re planning and we’ll arrange a call with the right people.',
} = Astro.props;
---
<section class="bg-grey py-24 text-center sm:py-32">
  <div class="container-x rise">
    <h2 class="title">{title}</h2>
    <p class="subtitle mx-auto mt-5 max-w-2xl">{text}</p>
    <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/contact" class="btn-primary">Contact us</a>
      <a href={`tel:${site.phoneLink}`} class="more">Call {site.phone} ›</a>
    </div>
  </div>
</section>
