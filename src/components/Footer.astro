---
import { site, footerLinks } from '../config/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Services', links: footerLinks.services },
  { title: 'Company', links: footerLinks.company },
  { title: 'Resources', links: footerLinks.tools },
];
---
<footer class="border-t border-line bg-grey pb-28 pt-12 text-xs text-muted lg:pb-10">
  <div class="container-x">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {cols.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="text-xs font-semibold text-ink">{col.title}</h2>
          <ul class="mt-3 space-y-2">
            {col.links.map((l) => <li><a class="hover:text-ink hover:underline" href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
      <div>
        <h2 class="text-xs font-semibold text-ink">Contact</h2>
        <ul class="mt-3 space-y-2">
          <li><a class="hover:text-ink hover:underline" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="hover:text-ink hover:underline" href={`tel:${site.phoneLink}`}>{site.phone}</a></li>
          <li><a class="hover:text-ink hover:underline" href={site.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p>
        Copyright © {year} {site.legalName}. Registered in {site.registeredIn}{site.companyNumber && `, company no. ${site.companyNumber}`}.
        {[site.address.street, `${site.address.town} ${site.address.postcode}`.trim()].join(', ')}.
      </p>
      <ul class="flex gap-5">
        {footerLinks.legal.map((l) => <li><a class="hover:text-ink hover:underline" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
