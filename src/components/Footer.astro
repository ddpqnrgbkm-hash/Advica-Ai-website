---
import Logo from './Logo.astro';
import { site, footerLinks, legalLinks } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-soft pb-28 pt-14 text-[0.95rem] lg:pb-12">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <a href="/" aria-label={`${site.name} home`}><Logo size="sm" /></a>
        <ul class="mt-6 space-y-1.5">
          <li><a class="hover:underline" href={`tel:${site.phoneLink}`}>{site.phone}</a></li>
          <li><a class="hover:underline" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="hover:underline" href={site.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
          {site.googleReviewsUrl && <li><a class="hover:underline" href={site.googleReviewsUrl} target="_blank" rel="noopener">Read our Google reviews<span class="sr-only"> (opens in a new tab)</span></a></li>}
        </ul>
      </div>
      {Object.entries(footerLinks).map(([title, links]) => (
        <nav aria-label={title}>
          <h2 class="text-base">{title}</h2>
          <ul class="mt-3 space-y-1.5">
            {links.map((l) => <li><a class="text-muted hover:text-ink hover:underline" href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-12 flex flex-col gap-4 border-t border-line pt-6 text-sm text-muted md:flex-row md:justify-between">
      <p>
        © {year} {site.legalName}. Registered in {site.registeredIn}{site.companyNumber ? `, company number ${site.companyNumber}` : ', company number [PLACEHOLDER]'}.<br />
        Registered office: {site.registeredOffice || '[PLACEHOLDER: registered office address]'}.
      </p>
      <ul class="flex gap-5">
        {legalLinks.map((l) => <li><a class="hover:text-ink hover:underline" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
