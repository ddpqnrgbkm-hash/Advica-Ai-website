---
import Logo from './Logo.astro';
import { site, footerLinks } from '../config/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Services', links: footerLinks.services },
  { title: 'Company', links: footerLinks.company },
  { title: 'Free tools', links: footerLinks.tools },
];
---
<footer class="on-dark bg-navy-deep pb-28 pt-16 text-white/75 lg:pb-12">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <Logo dark />
        <p class="mt-5 leading-relaxed">{site.tagline}.</p>
        <ul class="mt-6 space-y-2">
          <li><a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="hover:text-white" href={`tel:${site.phoneLink}`}>{site.phone}</a></li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={site.linkedin} target="_blank" rel="noopener">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              LinkedIn<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </div>
      {cols.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-white">{col.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => <li><a class="hover:text-white" href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.legalName}. Registered in {site.registeredIn}{site.companyNumber && `, company no. ${site.companyNumber}`}.
        {[site.address.street, `${site.address.town} ${site.address.postcode}`.trim()].join(', ')}.
      </p>
      <ul class="flex gap-6">
        {footerLinks.legal.map((l) => <li><a class="hover:text-white" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
