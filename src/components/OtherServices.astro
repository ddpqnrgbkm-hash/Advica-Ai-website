---
import { getCollection } from 'astro:content';
interface Props { exclude?: string }
const { exclude } = Astro.props;
const services = (await getCollection('services')).filter((s) => s.id !== exclude).sort((a, b) => a.data.order - b.data.order);
---
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {services.map((s) => (
    <a href={`/services/${s.id}`} class="glow-card glass group relative flex min-h-52 flex-col justify-between overflow-hidden p-8">
      <div aria-hidden="true" class="absolute -right-12 -top-12 size-48 rounded-full bg-brand/25 blur-3xl"></div>
      <span class="relative text-2xl font-semibold text-white">{s.data.title}</span>
      <span class="relative">
        <span class="block text-mist">{s.data.menuText}</span>
        <span class="mt-5 inline-flex items-center gap-2 font-medium text-sky">Explore <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
      </span>
    </a>
  ))}
</div>
