---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';

const studies = (await getCollection('caseStudies', (c) => !c.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<BaseLayout title="Case studies" description="Real projects delivered by Advica AI Solutions for UK businesses — the problem, what we built and what changed.">
  <PageHero eyebrow="Case studies" title="Real projects, real results." intro="The problem, what we built and what changed — shared with our clients’ permission." crumbs={[{ label: 'Case Studies' }]} />

  <section class="py-20 sm:py-28">
    <div class="container-x">
      {studies.length > 0 ? (
        <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {studies.map((c) => (
            <li class="reveal">
              <a href={`/case-studies/${c.id}`} class="glow-card glass group flex h-full flex-col overflow-hidden">
                <span class="relative flex min-h-44 items-end overflow-hidden p-7">
                  <span aria-hidden="true" class="absolute -right-10 -top-10 size-56 rounded-full bg-brand/35 blur-3xl"></span>
                  <span class="relative text-2xl font-semibold leading-snug text-white">{c.data.title}</span>
                </span>
                <span class="flex flex-1 flex-col border-t border-white/[0.06] p-7">
                  <span class="font-mono text-xs uppercase tracking-[0.14em] text-sky">{c.data.client} · {c.data.industry}</span>
                  <span class="mt-3 text-mist">{c.data.summary}</span>
                  <span class="mt-auto pt-6 font-medium text-sky">Read case study →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="reveal glass relative overflow-hidden p-10 text-center sm:p-16">
          <div aria-hidden="true" class="absolute left-1/2 top-0 h-64 w-[40rem] -translate-x-1/2 rounded-full bg-brand/25 blur-3xl"></div>
          <h2 class="relative text-3xl font-semibold text-white">Case studies are on their way</h2>
          <p class="relative mx-auto mt-4 max-w-xl text-lg text-mist">We’re writing up recent projects with our clients’ permission. In the meantime, we’re happy to talk you through relevant examples on a call.</p>
          <div class="relative mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <BookButton class="btn-primary" label="Ask about our work" />
            <a href="/services" class="btn-secondary">Explore our services</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</BaseLayout>
