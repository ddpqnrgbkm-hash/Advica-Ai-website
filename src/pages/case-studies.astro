---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';

const studies = (await getCollection('caseStudies', (c) => !c.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const bg: Record<string, string> = { 'ai-and-data': 'bg-sky', 'software-and-cloud': 'bg-lime', 'extra-engineers': 'bg-lilac' };
---
<BaseLayout title="Case studies" description="Real projects delivered by Advica AI Solutions for UK businesses — the problem, what we built and what changed.">
  <PageHero eyebrow="Case studies" title="Real projects, real results." intro="The problem, what we built and what changed — shared with our clients’ permission." crumbs={[{ label: 'Case Studies' }]} />

  <section class="py-20 sm:py-24">
    <div class="container-x">
      {studies.length > 0 ? (
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {studies.map((c) => (
            <li>
              <a href={`/case-studies/${c.id}`} class="group flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-white">
                <span class:list={['flex min-h-40 items-end p-7 font-display text-2xl font-bold leading-snug text-ink', bg[c.data.service]]}>{c.data.title}</span>
                <span class="flex flex-1 flex-col p-7">
                  <span class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">{c.data.client} · {c.data.industry}</span>
                  <span class="mt-3 text-muted">{c.data.summary}</span>
                  <span class="mt-auto pt-6 font-semibold text-brand group-hover:underline">Read case study →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="rounded-3xl border border-dashed border-ink/25 bg-white p-10 text-center sm:p-16">
          <h2 class="text-3xl font-bold">Case studies are on their way</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted">We’re writing up recent projects with our clients’ permission. In the meantime, we’re happy to talk you through relevant examples on a call.</p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <BookButton class="btn-primary" label="Ask about our work" />
            <a href="/services" class="btn-secondary">Explore our services</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</BaseLayout>
