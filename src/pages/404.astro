---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="Sorry, we couldn't find that page." noindex>
  <section class="on-dark relative isolate overflow-hidden py-24 sm:py-36">
    <div aria-hidden="true" class="grid-bg absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_30%_30%,#000,transparent_70%)]"></div>
    <div aria-hidden="true" class="absolute -left-20 top-0 -z-10 h-96 w-[40rem] rounded-full bg-brand/30 blur-[130px]"></div>
    <div class="container-x max-w-3xl">
      <p class="text-shine text-8xl font-semibold tracking-tighter sm:text-[10rem]">404</p>
      <h1 class="mt-4 text-4xl font-semibold text-white sm:text-5xl">We couldn’t find that page.</h1>
      <p class="mt-5 text-lg text-mist">It may have moved when we updated our website. Try one of these instead:</p>
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {[['Home', '/'], ['Services', '/services'], ['Pricing', '/pricing'], ['Contact', '/contact']].map(([l, h]) => (
          <li><a href={h} class="glow-card glass flex justify-between p-5 font-medium text-white">{l} <span aria-hidden="true" class="text-sky">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
