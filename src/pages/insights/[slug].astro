---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('insights', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props as { post: CollectionEntry<'insights'> };
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `${site.url}/insights/${post.id}`;

const more = (await getCollection('insights', (p) => !p.data.draft && p.id !== post.id))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Organization', name: d.author, url: site.url },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: url,
    image: `${site.url}/og-default.png`,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Insights', item: `${site.url}/insights` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---
<BaseLayout title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <article>
    <header class="on-dark bg-ink text-white">
      <div class="container-x max-w-4xl pb-16 pt-12 sm:pb-20 sm:pt-16">
        <nav aria-label="Breadcrumb" class="text-sm text-white/85">
          <a href="/" class="hover:text-white">Home</a> <span aria-hidden="true">/</span> <a href="/insights" class="hover:text-white">Insights</a>
        </nav>
        <p class="eyebrow mt-10">{d.category}</p>
        <h1 class="mt-5 text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">{d.title}</h1>
        <p class="mt-6 text-sm text-mist">
          {d.author} · <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>{d.readingTime && <> · {d.readingTime}</>}
        </p>
      </div>
    </header>

    <div class="container-x max-w-4xl py-16 sm:py-20">
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:tracking-tight prose-a:text-brand prose-a:underline-offset-4 prose-strong:text-ink">
        <Content />
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="border-t border-line bg-white py-16" aria-labelledby="more-h">
      <div class="container-x">
        <h2 id="more-h" class="text-2xl font-bold">More insights</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {more.map((p) => (
            <li><a href={`/insights/${p.id}`} class="card block h-full hover:border-ink"><span class="text-sm font-semibold text-brand">{p.data.category}</span><span class="mt-2 block font-display text-lg font-bold">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
