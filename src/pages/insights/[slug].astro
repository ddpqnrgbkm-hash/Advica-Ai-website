---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('insights', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props as { post: CollectionEntry<'insights'> };
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `${site.url}/insights/${post.id}`;

const more = (await getCollection('insights', (p) => !p.data.draft && p.id !== post.id))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Organization', name: d.author, url: site.url },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: url,
    image: `${site.url}/og-default.png`,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Insights', item: `${site.url}/insights` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---
<BaseLayout title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <article>
    <header class="on-dark relative isolate overflow-hidden border-b border-white/[0.06]">
      <div aria-hidden="true" class="grid-bg absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_80%_70%_at_50%_0%,#000,transparent)]"></div>
      <div aria-hidden="true" class="absolute -top-56 left-1/2 -z-10 h-[30rem] w-[50rem] -translate-x-1/2 rounded-full bg-deep/60 blur-[130px]"></div>
      <div class="container-x max-w-4xl pb-16 pt-10 sm:pb-20 sm:pt-14">
        <nav aria-label="Breadcrumb" class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-white/70">
          <a href="/" class="hover:text-sky">Home</a> <span aria-hidden="true" class="text-sky">/</span> <a href="/insights" class="hover:text-sky">Insights</a>
        </nav>
        <p class="eyebrow mt-12">{d.category}</p>
        <h1 class="mt-6 text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-white sm:text-5xl lg:text-6xl">{d.title}</h1>
        <p class="mt-8 font-mono text-xs uppercase tracking-[0.14em] text-mist">
          {d.author} · <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>{d.readingTime && <> · {d.readingTime}</>}
        </p>
      </div>
    </header>

    <div class="container-x max-w-3xl py-16 sm:py-20">
      <div class="prose prose-lg prose-invert max-w-none prose-headings:tracking-tight prose-headings:text-white prose-p:text-white/80 prose-li:text-white/80 prose-strong:text-white prose-a:text-sky prose-a:underline-offset-4 prose-li:marker:text-sky">
        <Content />
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="border-t border-white/[0.06] bg-ink py-16" aria-labelledby="more-h">
      <div class="container-x">
        <h2 id="more-h" class="text-2xl font-semibold text-white">More insights</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {more.map((p) => (
            <li><a href={`/insights/${p.id}`} class="glow-card glass group block h-full p-6"><span class="font-mono text-xs uppercase tracking-[0.14em] text-sky">{p.data.category}</span><span class="mt-3 block text-lg font-semibold text-white group-hover:text-sky">{p.data.title}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
