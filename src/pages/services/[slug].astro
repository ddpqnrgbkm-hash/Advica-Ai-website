---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BookButton from '../../components/BookButton.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBand from '../../components/CtaBand.astro';
import OtherServices from '../../components/OtherServices.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}
const { service } = Astro.props as { service: CollectionEntry<'services'> };
const d = service.data;

const jsonLd = [
  {
    '@type': 'Service',
    name: d.title,
    description: d.summary,
    serviceType: d.capabilities.map((c) => c.name),
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Services', item: `${site.url}/services` },
      { '@type': 'ListItem', position: 2, name: d.title, item: `${site.url}/services/${service.id}` },
    ],
  },
];
---
<BaseLayout title={d.seoTitle} description={d.seoDescription} jsonLd={jsonLd}>
  <PageHero eyebrow={d.title} title={d.headline} intro={d.summary} accent={d.accent} crumbs={[{ label: 'Services', href: '/services' }, { label: d.title }]}>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <BookButton class="btn-primary" label="Book a free call" />
      <a href="/estimate" class="btn-secondary">Estimate your project cost <span aria-hidden="true">→</span></a>
    </div>
  </PageHero>

  <!-- What's included: capabilities with a sticky jump list -->
  <section class="py-20 sm:py-28" aria-labelledby="what-h">
    <div class="container-x grid gap-12 lg:grid-cols-[17rem_1fr]">
      <div>
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow">What’s included</p>
          <h2 id="what-h" class="mt-5 text-3xl font-semibold text-white">What we can do for you</h2>
          <nav aria-label="On this page" class="mt-8 hidden lg:block">
            <ul class="space-y-1 border-l border-white/10">
              {d.capabilities.map((c) => (
                <li><a href={`#${c.id}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-mist hover:border-sky hover:text-white">{c.name}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {d.capabilities.map((c, i) => (
          <article id={c.id} class="reveal glow-card glass flex flex-col p-7">
            <span class="grid size-11 place-items-center rounded-xl border border-sky/30 bg-sky/10 font-mono text-sm text-sky shadow-[0_0_24px_-6px_rgba(60,200,255,0.7)]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-6 text-xl font-semibold text-white">{c.name}</h3>
            <p class="mt-3 leading-relaxed text-mist">{c.text}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {c.tags.map((t) => <li class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 font-mono text-[0.68rem] text-white/80">{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it's for + example outcomes -->
  <section class="border-y border-white/[0.06] bg-ink py-20 sm:py-28">
    <div class="container-x grid gap-16 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">Who it’s for</p>
        <h2 class="mt-5 text-3xl font-semibold text-white sm:text-4xl">This is for you if…</h2>
        <ul class="mt-8 space-y-5">
          {d.whoFor.map((w) => (
            <li class="flex gap-4 text-lg text-white/90">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-sky/15 text-sky">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              {w}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <p class="eyebrow">Example outcomes</p>
        <h2 class="mt-5 text-3xl font-semibold text-white sm:text-4xl">Examples of what we could build</h2>
        <p class="mt-3 text-sm text-mist">These are examples to give you an idea. Every project is planned around your business.</p>
        <ul class="mt-8 grid gap-3">
          {d.outcomes.map((o) => (
            <li class="relative overflow-hidden rounded-2xl border border-sky/20 bg-gradient-to-r from-sky/[0.08] to-transparent p-5 text-white/90">
              <span aria-hidden="true" class="absolute inset-y-0 left-0 w-0.5 bg-sky shadow-[0_0_12px_rgba(60,200,255,0.9)]"></span>
              {o}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="relative overflow-hidden py-20 sm:py-28" aria-labelledby="proc-h">
    <div aria-hidden="true" class="absolute left-0 top-1/2 -z-10 h-80 w-80 rounded-full bg-brand/20 blur-[120px]"></div>
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
          <p class="eyebrow">Process</p>
          <h2 id="proc-h" class="mt-5 text-3xl font-semibold text-white sm:text-5xl">How we’ll work together</h2>
        </div>
        <a href="/how-it-works" class="btn-secondary self-start lg:self-auto">Full process &amp; Sprint 0 <span aria-hidden="true">→</span></a>
      </div>
      <ol class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        <div aria-hidden="true" class="absolute left-6 right-6 top-6 hidden h-px bg-gradient-to-r from-sky via-brand to-transparent lg:block"></div>
        {d.process.map((p, i) => (
          <li class="reveal relative">
            <span class="relative grid size-12 place-items-center rounded-full border border-sky/40 bg-void font-mono text-sm text-sky shadow-[0_0_30px_-4px_rgba(60,200,255,0.6)]">0{i + 1}</span>
            <h3 class="mt-6 text-lg font-semibold text-white">{p.name}</h3>
            <p class="mt-2 leading-relaxed text-mist">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-white/[0.06] bg-ink py-20 sm:py-28" aria-labelledby="faq-h">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h" class="mt-5 text-3xl font-semibold text-white sm:text-4xl">{d.title} questions</h2>
      </div>
      <FAQ items={d.faqs} />
    </div>
  </section>

  <section class="py-20" aria-labelledby="more-h">
    <div class="container-x">
      <h2 id="more-h" class="text-2xl font-semibold text-white">Other ways we help</h2>
      <div class="mt-8"><OtherServices exclude={service.id} /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
