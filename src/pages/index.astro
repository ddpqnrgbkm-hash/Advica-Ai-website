---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { homeFaqs as faqs } from '../data/home';
---
<BaseLayout
  title="Custom software and AI tools for UK businesses"
  description="We build custom software, apps and AI tools that save your team time and cut mistakes. Written plan and quote before any work starts. Book a free call."
  jsonLd={[{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}
>
  <HomeContent />
</BaseLayout>
