---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/BookButton.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, stats, testimonials, pricing } from '../config/site';
import { steps } from '../data/steps';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = (await getCollection('caseStudies', (c) => !c.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const shownTestimonials = testimonials.filter((t) => t.show);
const gbp = (n: number) => '£' + n.toLocaleString('en-GB');

// What each stage costs, shown beside the four steps
const stepCost = ['Free', `From ${gbp(pricing.sprintZeroPrice)}`, 'Fixed price from Sprint 0', 'Monthly, or handover'];

const faqs = [
  { q: 'What kind of businesses do you work with?', a: 'Small and medium-sized UK businesses, usually ones that have outgrown spreadsheets and off-the-shelf software, or want to start using AI but need someone technical to do it properly.' },
  { q: 'We’re not technical. Is that a problem?', a: 'No. Tell us what the problem is and we’ll handle the technical side. We’ll explain your options in everyday language, and you’ll always know what you’re paying for.' },
  { q: 'How much does a project cost?', a: `It depends on the project. Sprint 0, the planning stage, starts at ${gbp(pricing.sprintZeroPrice)} and ends with a fixed price for the build. For a rough idea before then, try the cost estimator.` },
  { q: 'Can we spread the cost?', a: `Yes. You can pay in stages as the work is delivered, or eligible businesses can spread the cost monthly over ${pricing.financeYears} years through our finance partners, subject to their approval.` },
];
const faqLd = { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout
  title="Bespoke AI and software engineering for UK businesses"
  description="Advica AI Solutions builds custom AI tools, apps and data systems for UK small and medium-sized businesses. Fixed-price planning from £4,250. Based in Leyland, Lancashire."
  jsonLd={[faqLd]}
>
  <!-- ================= INTRO ================= -->
  <section class="border-b border-line">
    <div class="container-x pb-14 pt-14 sm:pb-20 sm:pt-20">
      <div class="grid gap-10 lg:grid-cols-[1.35fr_1fr] lg:items-end lg:gap-16">
        <h1 class="heading-xl">Custom AI and software for <span class="text-blue">UK businesses</span></h1>
        <div>
          <p class="text-lg sm:text-xl">We plan, build and support AI tools, apps and data systems for small and medium-sized businesses. Every project starts with a fixed-price plan, so you know the cost before we build anything.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <BookButton class="btn-primary" label="Book a free call" />
            <a href="/estimate" class="btn-secondary">Estimate your project cost</a>
          </div>
        </div>
      </div>

      <dl class="mt-16 grid border-t border-line sm:grid-cols-3">
        <div class="border-b border-line py-6 sm:border-b-0 sm:border-r sm:pr-8">
          <dt class="text-sm text-muted">Planning stage</dt>
          <dd class="mt-1 text-xl font-bold text-ink">Sprint 0 from {gbp(pricing.sprintZeroPrice)}</dd>
          <dd class="mt-1 text-sm text-muted">Ends with a fixed price for the build</dd>
        </div>
        <div class="border-b border-line py-6 sm:border-b-0 sm:border-r sm:px-8">
          <dt class="text-sm text-muted">Paying for the build</dt>
          <dd class="mt-1 text-xl font-bold text-ink">In stages, or monthly</dd>
          <dd class="mt-1 text-sm text-muted">Spread over {pricing.financeYears} years, subject to approval</dd>
        </div>
        <div class="py-6 sm:pl-8">
          <dt class="text-sm text-muted">Where we are</dt>
          <dd class="mt-1 text-xl font-bold text-ink">{site.address.town}, Lancashire</dd>
          <dd class="mt-1 text-sm text-muted">Working with businesses across the UK</dd>
        </div>
      </dl>
    </div>
  </section>

  {stats.length > 0 && (
    <section class="border-b border-line py-12">
      <dl class="container-x grid gap-8 sm:grid-cols-3">
        {stats.map((s) => (
          <div><dt class="text-sm text-muted">{s.label}</dt><dd class="text-5xl font-black text-ink">{s.value}</dd></div>
        ))}
      </dl>
    </section>
  )}

  <!-- ================= SERVICES ================= -->
  <section class="py-16 sm:py-24" aria-labelledby="services-h">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <h2 id="services-h" class="heading-lg">What we do</h2>
        <a href="/services" class="link">All services</a>
      </div>
      <ul class="mt-10 border-t-2 border-ink">
        {services.map((s) => (
          <li class="border-b border-line">
            <a href={`/services/${s.id}`} class="group grid gap-4 py-8 sm:py-10 lg:grid-cols-[18rem_1fr_auto] lg:gap-12">
              <h3 class="text-2xl font-bold group-hover:text-blue">{s.data.title}</h3>
              <div>
                <p class="text-lg text-ink">{s.data.summary}</p>
                <p class="mt-3 text-[0.95rem] text-muted">{s.data.capabilities.map((c) => c.name).join(', ')}.</p>
              </div>
              <span class="self-start whitespace-nowrap font-semibold text-blue group-hover:underline">Read more <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= HOW A PROJECT WORKS ================= -->
  <section class="bg-soft py-16 sm:py-24" aria-labelledby="how-h">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <h2 id="how-h" class="heading-lg">How a project works</h2>
        <a href="/how-it-works" class="link">More detail</a>
      </div>
      <ol class="mt-10 border-t-2 border-ink">
        {steps.map((s, i) => (
          <li class="grid gap-2 border-b border-line py-7 sm:grid-cols-[3rem_14rem_1fr] lg:grid-cols-[3rem_14rem_1fr_auto] lg:gap-10">
            <span class="text-lg font-black text-blue">{i + 1}</span>
            <h3 class="text-lg font-bold">{s.name}</h3>
            <p class="sm:col-start-3 lg:col-start-auto">{s.text}</p>
            <p class="font-semibold text-ink sm:col-start-3 lg:col-start-auto lg:whitespace-nowrap lg:text-right">{stepCost[i]}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-muted">If you go ahead with the build, {pricing.sprintZeroCredit} of what you paid for Sprint 0 comes off your build invoice.</p>
    </div>
  </section>

  <!-- ================= CLIENT FEEDBACK ================= -->
  <section class="py-16 sm:py-24" aria-labelledby="proof-h">
    <div class="container-x">
      <h2 id="proof-h" class="heading-lg">What clients say</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-16">
        {shownTestimonials.map((t) => (
          <figure class="border-l-2 border-blue pl-6">
            <blockquote class="text-xl leading-relaxed text-ink">“{t.quote}”</blockquote>
            <figcaption class="mt-4 text-sm text-muted">
              {t.name ? <><span class="font-semibold text-ink">{t.name}</span>{t.role && <>, {t.role}</>}</> : 'Advica client'}
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-12 border-t border-line pt-6 text-muted">
        {caseStudies.length > 0
          ? <>Read about our recent work in our <a class="link" href="/case-studies">case studies</a>.</>
          : <>We’re writing up case studies with our clients’ permission. If you’d like to hear about similar projects to yours, <a class="link" href="/contact">ask us</a>.</>}
      </p>
    </div>
  </section>

  <!-- ================= FREE TOOLS ================= -->
  <section class="border-t border-line py-16 sm:py-20" aria-labelledby="tools-h">
    <div class="container-x">
      <h2 id="tools-h" class="heading-lg">Not ready to talk yet?</h2>
      <div class="mt-10 grid gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-2">
        <a href="/estimate" class="group bg-white p-8 hover:bg-soft">
          <h3 class="text-xl font-bold group-hover:text-blue">Project cost estimator</h3>
          <p class="mt-2">Five questions about your project. You’ll get an idea of its size and the best next step. Takes about two minutes.</p>
          <span class="mt-5 inline-block font-semibold text-blue group-hover:underline">Start the estimator →</span>
        </a>
        <a href="/ai-readiness" class="group bg-white p-8 hover:bg-soft">
          <h3 class="text-xl font-bold group-hover:text-blue">AI readiness quiz</h3>
          <p class="mt-2">Eight questions about your business. You’ll get a score and practical suggestions. Takes about three minutes.</p>
          <span class="mt-5 inline-block font-semibold text-blue group-hover:underline">Take the quiz →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="border-t border-line py-16 sm:py-24" aria-labelledby="faq-h">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.7fr] lg:gap-16">
      <div>
        <h2 id="faq-h" class="heading-lg">Common questions</h2>
        <p class="mt-5 text-muted">There’s more on the <a class="link" href="/how-it-works">How it works</a> and <a class="link" href="/pricing">Pricing</a> pages.</p>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
