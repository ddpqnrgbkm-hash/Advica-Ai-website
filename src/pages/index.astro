---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/BookButton.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { stats, testimonials } from '../config/site';
import { steps } from '../data/steps';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = (await getCollection('caseStudies', (c) => !c.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
const shownTestimonials = testimonials.filter((t) => t.show);

const icons: Record<string, string> = {
  'ai-and-data': 'M12 3v3m0 12v3m9-9h-3M6 12H3m15.4-6.4-2.1 2.1M7.7 16.3l-2.1 2.1m0-12.8 2.1 2.1m8.6 8.6 2.1 2.1M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  'software-and-cloud': 'M8 9l-3 3 3 3m8-6 3 3-3 3M13.5 6l-3 12',
  'extra-engineers': 'M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1m20 0v-1a4 4 0 0 0-3-3.9M15 3.1a4 4 0 0 1 0 7.8M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z',
};

const faqs = [
  {
    q: 'What kind of businesses do you work with?',
    a: 'UK small and mid-sized businesses — typically firms that have outgrown spreadsheets and off-the-shelf tools, or want to use AI properly but need a technical partner to do it.',
  },
  {
    q: 'We’re not technical. Is that a problem?',
    a: 'Not at all. Bring the business problem and we’ll handle the technical side. We explain options in plain English, and you’ll always know what you’re paying for and why.',
  },
  {
    q: 'What do I need to prepare before we start?',
    a: 'Just your idea or the problem you want solved. You don’t need a specification — working out the scope, design and technical plan is exactly what Sprint 0 is for.',
  },
  {
    q: 'How much does a project cost?',
    a: 'It depends on what you need, so we don’t publish fixed prices. Try our project cost estimator for an indicative range. After Sprint 0 you get a fixed plan and cost before the main build starts.',
  },
  {
    q: 'Can we spread the cost?',
    a: 'Yes. As well as paying by milestone, eligible businesses can spread the cost monthly over 3 to 5 years through our finance partners, subject to their approval.',
  },
  {
    q: 'How do we stay in touch during the project?',
    a: 'You get a dedicated point of contact, a shared channel for day-to-day questions and regular demos, so you always know how the build is progressing.',
  },
  {
    q: 'What happens after launch?',
    a: 'Your choice. We can hand everything over to your own team with documentation and training, or keep supporting and improving the system for you.',
  },
];
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  title="Bespoke AI and software engineering for UK businesses"
  description="Advica AI Solutions designs, builds and supports custom AI tools, apps and data platforms for UK SMEs and mid-market businesses. Clear plan first, then build."
  jsonLd={[faqLd]}
>
  <!-- ============ HERO ============ -->
  <section class="on-dark relative overflow-hidden bg-ink text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_at_70%_30%,#000,transparent_70%)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-0 size-[38rem] rounded-full bg-brand/40 blur-[120px]"></div>

    <div class="container-x relative grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-[1.25fr_1fr] lg:py-32">
      <div>
        <p class="eyebrow">Bespoke AI &amp; software engineering · UK</p>
        <h1 class="mt-6 text-[2.6rem] font-semibold leading-[1.05] sm:text-6xl lg:text-[4.25rem]">
          AI and software, built around how <span class="text-sky">your business</span> works.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/75 sm:text-xl">
          We design, build and support custom AI tools, apps and data platforms for UK small and mid-sized businesses — with a clear, fixed plan before the build begins.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <BookButton class="btn bg-sky text-ink hover:bg-white" label="Book a free call" />
          <a href="/estimate" class="btn-secondary">Estimate your project cost</a>
        </div>
      </div>

      <!-- Illustrative "plan" card, built in code (no stock imagery) -->
      <div aria-hidden="true" class="relative mx-auto hidden w-full max-w-md sm:block">
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-sky/25 to-transparent blur-2xl"></div>
        <div class="relative rounded-3xl border border-white/10 bg-ink-2/90 p-6 shadow-2xl sm:p-8">
          <div class="flex items-center justify-between text-sm">
            <span class="font-semibold text-white">Your project plan</span>
            <span class="rounded-full bg-sky/15 px-3 py-1 text-xs font-semibold text-sky">Sprint 0</span>
          </div>
          <ol class="mt-6 space-y-3">
            {steps.map((s, i) => (
              <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <span class:list={['grid size-9 shrink-0 place-items-center rounded-full text-sm font-bold',
                  i < 2 ? 'bg-sky text-ink' : 'border border-white/20 text-white/70']}>{i < 2 ? '✓' : i + 1}</span>
                <span>
                  <span class="block text-sm font-semibold text-white">{s.name}</span>
                  <span class="block text-xs text-white/55">{s.short}</span>
                </span>
              </li>
            ))}
          </ol>
          <div class="mt-6 h-2 overflow-hidden rounded-full bg-white/10"><div class="h-full w-1/2 rounded-full bg-gradient-to-r from-sky to-brand"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ REASSURANCE STRIP ============ -->
  <section class="border-b border-line bg-white">
    <ul class="container-x grid gap-6 py-8 text-sm font-medium text-ink/80 sm:grid-cols-2 lg:grid-cols-4">
      {[
        'Plain-English advice, no jargon',
        'Fixed plan and price before the build',
        'Pay by milestone or spread monthly',
        'Hand-over or ongoing support — your choice',
      ].map((t) => (
        <li class="flex items-center gap-3">
          <svg class="size-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {t}
        </li>
      ))}
    </ul>
  </section>

  {stats.length > 0 && (
    <section class="bg-white pb-12">
      <dl class="container-x grid gap-8 sm:grid-cols-3">
        {stats.map((s) => (
          <div><dt class="text-sm text-muted">{s.label}</dt><dd class="font-display text-5xl font-semibold">{s.value}</dd></div>
        ))}
      </dl>
    </section>
  )}

  <!-- ============ SERVICES ============ -->
  <section class="py-20 sm:py-28" aria-labelledby="services-h">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">What we do</p>
        <h2 id="services-h" class="mt-4 text-3xl font-semibold sm:text-5xl">Three ways we help</h2>
        <p class="mt-5 text-lg text-muted">Whether you need a new AI tool, a full software build or a few more skilled hands, we bring the engineering — you keep focus on running the business.</p>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {services.map((s) => (
          <a href={`/services/${s.id}`} class="card group flex flex-col transition-shadow hover:shadow-xl hover:shadow-ink/5">
            <span class="grid size-12 place-items-center rounded-xl bg-ink text-sky">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[s.id]} /></svg>
            </span>
            <h3 class="mt-6 text-2xl font-semibold">{s.data.title}</h3>
            <p class="mt-3 text-muted">{s.data.summary}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.data.includes.map((i) => <li class="rounded-full bg-paper px-3 py-1 text-xs font-medium text-ink/80">{i.name}</li>)}
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 pt-8 font-semibold text-brand">
              Explore {s.data.shortTitle}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="border-y border-line bg-white py-20 sm:py-28" aria-labelledby="how-h">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">How it works</p>
          <h2 id="how-h" class="mt-4 text-3xl font-semibold sm:text-5xl">Four steps, no surprises</h2>
        </div>
        <a href="/how-it-works" class="link">See the full process</a>
      </div>
      <ol class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="bg-white p-7">
            <span class="font-display text-5xl font-semibold text-brand/20">0{i + 1}</span>
            <h3 class="mt-4 text-xl font-semibold">{s.name}</h3>
            <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ PRICING TEASER ============ -->
  <section class="py-20 sm:py-28" aria-labelledby="pay-h">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Paying for it</p>
        <h2 id="pay-h" class="mt-4 text-3xl font-semibold sm:text-5xl">Two simple ways to pay</h2>
        <p class="mt-5 text-lg text-muted">Pay as each stage is delivered, or spread the cost monthly so your cash stays free for running and growing the business.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/pricing" class="btn-primary">See pricing options</a>
          <a href="/estimate" class="btn-secondary">Get an indicative price</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card">
          <h3 class="text-xl font-semibold">Milestone billing</h3>
          <p class="mt-3 text-muted">You pay in stages as agreed milestones are delivered. Clear, predictable and tied to progress.</p>
        </div>
        <div class="card border-ink bg-ink text-white">
          <h3 class="text-xl font-semibold">Monthly financing</h3>
          <p class="mt-3 text-white/70">Spread the cost over 3–5 years through our finance partners, subject to approval.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FREE TOOLS ============ -->
  <section class="pb-20 sm:pb-28" aria-labelledby="tools-h">
    <div class="container-x">
      <h2 id="tools-h" class="sr-only">Free tools</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/estimate" class="group relative overflow-hidden rounded-2xl bg-brand p-8 text-white sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-white/70">2-minute tool</p>
          <h3 class="mt-3 text-2xl font-semibold sm:text-3xl">What might my project cost?</h3>
          <p class="mt-3 max-w-md text-white/80">Answer five quick questions and get an indicative price range.</p>
          <span class="mt-8 inline-flex items-center gap-2 font-semibold">Start the estimator <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
        </a>
        <a href="/ai-readiness" class="group relative overflow-hidden rounded-2xl border border-line bg-white p-8 sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand">3-minute quiz</p>
          <h3 class="mt-3 text-2xl font-semibold sm:text-3xl">How ready is your business for AI?</h3>
          <p class="mt-3 max-w-md text-muted">Eight questions, an instant score and practical next steps.</p>
          <span class="mt-8 inline-flex items-center gap-2 font-semibold text-brand">Take the quiz <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ PROOF ============ -->
  <section class="border-y border-line bg-white py-20 sm:py-28" aria-labelledby="proof-h">
    <div class="container-x">
      <p class="eyebrow">Client feedback</p>
      <h2 id="proof-h" class="mt-4 text-3xl font-semibold sm:text-5xl">What clients say</h2>

      {shownTestimonials.length > 0 && (
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {shownTestimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl bg-paper p-8">
              <svg class="size-8 text-brand" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M13 8H7a4 4 0 0 0-4 4v6h6v6l4-6V8zm16 0h-6a4 4 0 0 0-4 4v6h6v6l4-6V8z"/></svg>
              <blockquote class="mt-5 flex-1 text-lg leading-relaxed">“{t.quote}”</blockquote>
              <figcaption class="mt-6 text-sm text-muted">
                {t.name ? <><span class="font-semibold text-ink">{t.name}</span>{t.role && <>, {t.role}</>}</> : 'Client'}
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      <div class="mt-16 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <h3 class="text-2xl font-semibold">Case studies</h3>
        {caseStudies.length > 0 && <a href="/case-studies" class="link">All case studies</a>}
      </div>
      {caseStudies.length > 0 ? (
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {caseStudies.map((c) => (
            <a href={`/case-studies/${c.id}`} class="card hover:shadow-lg">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">{c.data.industry}</p>
              <h4 class="mt-3 text-xl font-semibold">{c.data.title}</h4>
              <p class="mt-3 text-muted">{c.data.summary}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-8 rounded-2xl border border-dashed border-ink/20 p-8 text-center sm:p-12">
          <p class="mx-auto max-w-xl text-muted">We’re writing up recent projects with our clients’ permission. In the meantime, we’re happy to talk you through relevant examples on a call.</p>
          <BookButton class="btn-secondary mt-6" label="Ask about our work" />
        </div>
      )}
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="py-20 sm:py-28" aria-labelledby="faq-h">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h" class="mt-4 text-3xl font-semibold sm:text-5xl">Common questions</h2>
        <p class="mt-5 text-muted">Can’t see yours? <a class="link" href="/contact">Ask us directly</a>.</p>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
