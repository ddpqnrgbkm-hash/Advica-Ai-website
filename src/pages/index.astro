---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/BookButton.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroVisual from '../components/HeroVisual.astro';
import FlowLines from '../components/FlowLines.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import { stats, testimonials, pricing } from '../config/site';
import { steps } from '../data/steps';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = (await getCollection('caseStudies', (c) => !c.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const shownTestimonials = testimonials.filter((t) => t.show);
const gbp = (n: number) => '£' + n.toLocaleString('en-GB');

const reasons = [
  { title: 'A plan before you commit', text: 'Sprint 0 gives you a full plan and a fixed price for the build before any development starts.', icon: 'M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { title: 'No jargon', text: 'We explain things clearly, so you always know what we’re building and why.', icon: 'M8 10h8M8 14h5m-9 6l2.5-3H18a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v7a3 3 0 0 0 3 3' },
  { title: 'Flexible payment', text: `Pay in stages as the work is delivered, or spread the cost monthly over ${pricing.financeYears} years.`, icon: 'M3 10h18M7 15h2m4 0h4M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z' },
  { title: 'Support when you need it', text: 'Once it’s finished, we can hand it over to your team or look after it for you.', icon: 'M4 12h16m-6-6l6 6-6 6' },
];

const faqs = [
  { q: 'What kind of businesses do you work with?', a: 'UK small and mid-sized businesses, typically firms that have outgrown spreadsheets and off-the-shelf tools, or want to use AI properly but need a technical partner to do it.' },
  { q: 'We’re not technical. Is that a problem?', a: 'Not at all. Bring the business problem and we’ll handle the technical side. We explain options in plain English, and you’ll always know what you’re paying for and why.' },
  { q: 'How much does a project cost?', a: 'It depends on what you need. Try our project cost estimator for an indicative guide. After Sprint 0 you get a fixed plan and price before the main build starts.' },
  { q: 'Can we spread the cost?', a: `Yes. As well as paying by milestone, eligible businesses can spread the cost monthly over ${pricing.financeYears} years through our finance partners, subject to their approval.` },
];
const faqLd = { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout
  title="Bespoke AI and software engineering for UK businesses"
  description="Advica AI Solutions designs, builds and supports custom AI tools, apps and data platforms for UK SMEs and mid-market businesses. Clear plan first, then build."
  jsonLd={[faqLd]}
>
  <!-- ================= HERO ================= -->
  <section class="relative isolate overflow-hidden bg-[radial-gradient(ellipse_at_50%_0%,#ffffff_0%,#eef2f5_55%,#e1e7ec_100%)]">
    <FlowLines class="absolute inset-0 -z-10 size-full" />
    <div class="container-x grid items-center gap-20 pb-28 pt-16 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-12 lg:pb-32 lg:pt-24">
      <div>
        <p class="eyebrow">AI and software for UK businesses</p>
        <h1 class="mt-6 text-[2.6rem] font-bold leading-[1.08] tracking-tight sm:text-6xl lg:text-[4.1rem]">
          We build AI tools and software <span class="text-brand">for UK businesses.</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-body sm:text-xl">
          We help small and medium-sized businesses save time and money with custom AI tools, apps and data systems. You get a clear plan and a fixed price before any work starts.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <BookButton class="btn-primary" label="Book a free call" />
          <a href="/estimate" class="btn-secondary">Estimate your project cost <span aria-hidden="true">→</span></a>
        </div>
        <ul class="mt-10 grid gap-3 text-sm font-medium text-navy sm:flex sm:flex-wrap sm:gap-x-7">
          {['Fixed price agreed up front', 'No technical jargon', 'Option to pay monthly'].map((t) => (
            <li class="flex items-center gap-2">
              <svg class="size-4 shrink-0 text-teal-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>{t}
            </li>
          ))}
        </ul>
      </div>
      <div class="px-4 sm:px-10 lg:px-0">
        <HeroVisual />
        <p class="mt-16 text-center text-xs font-medium uppercase tracking-widest text-muted">Illustrative example</p>
      </div>
    </div>
  </section>

  {stats.length > 0 && (
    <section class="border-y border-line bg-white py-12">
      <dl class="container-x grid gap-8 sm:grid-cols-3">
        {stats.map((s) => (
          <div><dt class="text-sm text-muted">{s.label}</dt><dd class="text-brand mt-1 font-display text-5xl font-bold">{s.value}</dd></div>
        ))}
      </dl>
    </section>
  )}

  <!-- ================= WHAT WE BUILD ================= -->
  <section class="overflow-x-clip bg-white py-24 sm:py-32" aria-labelledby="build-h">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What we do</p>
        <h2 id="build-h" class="mt-5 text-4xl font-bold sm:text-5xl">How we can help</h2>
        <p class="mt-5 text-lg text-muted">We can build you an AI tool, an app or a full system, or give you extra engineers to work with your team.</p>
      </div>
      <div class="mt-14"><ProductShowcase /></div>
    </div>
  </section>

  <!-- ================= WHY ADVICA ================= -->
  <section class="py-24 sm:py-32" aria-labelledby="why-h">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="eyebrow">Why work with us</p>
          <h2 id="why-h" class="mt-5 text-4xl font-bold leading-tight sm:text-5xl">Simple to work with, and clear about cost.</h2>
        </div>
        <p class="text-lg text-muted lg:pb-2">We plan everything properly before we start, explain things in everyday language and make sure you get what we agreed.</p>
      </div>
      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r) => (
          <li class="card lift">
            <span class="bg-brand-gradient grid size-12 place-items-center rounded-2xl text-white">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={r.icon} /></svg>
            </span>
            <h3 class="mt-7 text-xl font-bold">{r.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section class="border-y border-line bg-white py-24 sm:py-32" aria-labelledby="how-h">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 id="how-h" class="mt-5 text-4xl font-bold sm:text-5xl">How a project works</h2>
        </div>
        <a href="/how-it-works" class="btn-secondary self-start lg:self-auto">See the full process <span aria-hidden="true">→</span></a>
      </div>
      <ol class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        <div aria-hidden="true" class="absolute left-7 right-7 top-7 hidden h-0.5 bg-gradient-to-r from-navy via-mid to-teal lg:block"></div>
        {steps.map((s, i) => (
          <li class="relative">
            <span class="relative grid size-14 place-items-center rounded-full border-4 border-white bg-navy font-display text-lg font-bold text-white shadow-[0_10px_25px_-10px_rgba(31,53,109,0.7)]">{i + 1}</span>
            <h3 class="mt-6 text-xl font-bold">{s.name}</h3>
            <p class="mt-1 text-sm font-semibold text-teal-ink">{s.short}</p>
            <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-14 rounded-2xl bg-page p-5 text-body">Sprint 0 starts at <strong class="text-navy">{gbp(pricing.sprintZeroPrice)}</strong>. If you go ahead with the build, <strong class="text-navy">{pricing.sprintZeroCredit}</strong> of what you paid comes off your build invoice. <a href="/pricing" class="link">See pricing</a></p>
    </div>
  </section>

  <!-- ================= TESTIMONIALS ================= -->
  <section class="py-24 sm:py-32" aria-labelledby="proof-h">
    <div class="container-x" data-slider>
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Client feedback</p>
          <h2 id="proof-h" class="mt-5 text-4xl font-bold sm:text-5xl">What clients say</h2>
        </div>
        <div data-controls hidden class="flex gap-2">
          <button type="button" data-prev class="grid size-12 place-items-center rounded-full border border-line bg-white text-navy hover:border-navy disabled:opacity-30" aria-label="Previous"><span aria-hidden="true">←</span></button>
          <button type="button" data-next class="grid size-12 place-items-center rounded-full border border-line bg-white text-navy hover:border-navy disabled:opacity-30" aria-label="Next"><span aria-hidden="true">→</span></button>
        </div>
      </div>
      <ul data-track class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-6 [scrollbar-width:none]">
        {shownTestimonials.map((t) => (
          <li class="w-[88%] shrink-0 snap-start sm:w-[calc(50%-12px)]">
            <figure class="card flex h-full flex-col sm:p-10">
              <svg class="size-10 text-teal" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M13 8H7a4 4 0 0 0-4 4v6h6v6l4-6V8zm16 0h-6a4 4 0 0 0-4 4v6h6v6l4-6V8z"/></svg>
              <blockquote class="mt-6 flex-1 text-lg leading-relaxed text-navy sm:text-xl">“{t.quote}”</blockquote>
              <figcaption class="mt-8 text-sm font-semibold uppercase tracking-wider text-muted">
                {t.name ? <><span class="text-navy">{t.name}</span>{t.role && <> · {t.role}</>}</> : 'Client'}
              </figcaption>
            </figure>
          </li>
        ))}
        <li class="w-[88%] shrink-0 snap-start sm:w-[calc(50%-12px)]">
          <div class="on-dark bg-brand-gradient flex h-full flex-col justify-between rounded-3xl p-8 text-white sm:p-10">
            {caseStudies.length > 0 ? (
              <>
                <p class="font-display text-2xl font-bold">See the projects behind the feedback.</p>
                <a href="/case-studies" class="btn-light mt-8 self-start">Read case studies</a>
              </>
            ) : (
              <>
                <div>
                  <p class="font-display text-2xl font-bold leading-snug">Case studies are on their way.</p>
                  <p class="mt-3 text-white/85">We’re writing up recent projects with our clients’ permission. Ask us for relevant examples on a call.</p>
                </div>
                <BookButton class="btn-light mt-8 self-start" label="Ask about our work" />
              </>
            )}
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================= FREE TOOLS ================= -->
  <section class="pb-8" aria-labelledby="tools-h">
    <div class="container-x">
      <h2 id="tools-h" class="sr-only">Free tools</h2>
      <div class="grid gap-5 md:grid-cols-2">
        <a href="/estimate" class="card lift group flex min-h-72 flex-col justify-between sm:p-10">
          <div aria-hidden="true" class="flex h-20 items-end gap-2">
            {[30, 48, 40, 66, 58, 82, 74, 100].map((v) => <span class="w-full rounded-t-md bg-gradient-to-t from-navy to-mid" style={`height:${v}%`}></span>)}
          </div>
          <span>
            <span class="text-sm font-semibold uppercase tracking-wider text-teal-ink">Free · 2 minutes</span>
            <span class="mt-3 block font-display text-3xl font-bold text-navy">What might my project cost?</span>
            <span class="mt-3 block max-w-md text-muted">Answer five quick questions for an indicative guide and the best next step.</span>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-navy">Start the estimator <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
          </span>
        </a>
        <a href="/ai-readiness" class="card lift group flex min-h-72 flex-col justify-between sm:p-10">
          <div aria-hidden="true" class="grid size-20 place-items-center rounded-full" style="background:conic-gradient(var(--color-mid) 0 252deg, var(--color-line) 0)">
            <span class="grid size-16 place-items-center rounded-full bg-white font-display text-base font-bold text-navy">70%</span>
          </div>
          <span>
            <span class="text-sm font-semibold uppercase tracking-wider text-teal-ink">Free · 3 minutes</span>
            <span class="mt-3 block font-display text-3xl font-bold text-navy">How ready is your business for AI?</span>
            <span class="mt-3 block max-w-md text-muted">Eight questions, an instant score and practical next steps.</span>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-navy">Take the quiz <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="py-24 sm:py-28" aria-labelledby="faq-h">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h" class="mt-5 text-4xl font-bold sm:text-5xl">Common questions</h2>
        <p class="mt-5 text-muted">More on <a class="link" href="/how-it-works">how it works</a> and <a class="link" href="/pricing">pricing</a>.</p>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
