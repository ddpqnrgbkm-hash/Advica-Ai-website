---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { stats, testimonials, pricing } from '../config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const [first, second, ...rest] = services;
const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const shownTestimonials = testimonials.filter((t) => t.show).reverse();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Panel colours for the four smaller service panels: alternate light and dark
const gridTone = ['light', 'dark', 'dark', 'light'];

const stages = [
  { name: 'Discover', text: 'We get to know your organisation, your systems and the outcome you need, and agree whether we are the right partner.' },
  { name: 'Plan', text: 'A short, paid discovery phase called Sprint 0 sets out the architecture, scope, timeline and a fixed cost for the build.' },
  { name: 'Build', text: 'We deliver in short cycles with regular demonstrations, so your team can see progress and steer the work.' },
  { name: 'Run', text: 'Once live, we support and improve what we built, or hand it over to your team with full documentation.' },
];

const models = [
  { name: 'Project delivery', text: 'A defined outcome, scope and cost, delivered by a team we lead and manage.' },
  { name: 'Dedicated teams', text: 'Engineers and specialists who join your organisation and work to your priorities.' },
  { name: 'Managed services', text: 'Ongoing support, monitoring and improvement of the systems you rely on.' },
];
---
<BaseLayout
  title="AI, data, cloud and software engineering"
  description="Advica AI Solutions designs, builds and runs AI, data, cloud and software systems for organisations in the UK, from first plan to full scale."
>
  <!-- ================= HERO ================= -->
  <section class="pb-20 pt-20 text-center sm:pb-28 sm:pt-28">
    <div class="container-wide">
      <h1 class="display mx-auto max-w-[1100px] lg:!text-[4.6rem]">AI and software engineering,<br class="hidden lg:block" /> <span class="text-mid">from first plan to full scale.</span></h1>
      <p class="subtitle mx-auto mt-7 max-w-2xl">We design, build and run AI, data, cloud and software systems for organisations across the UK.</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-5 sm:flex-row sm:gap-8">
        <a href="/contact" class="btn-primary">Talk to us</a>
        <a href="/services" class="more">Explore our services ›</a>
      </div>
    </div>
  </section>

  {stats.length > 0 && (
    <section class="pb-16">
      <dl class="container-x grid gap-8 text-center sm:grid-cols-3">
        {stats.map((s) => <div><dd class="text-5xl font-semibold tracking-tight">{s.value}</dd><dt class="mt-2 text-muted">{s.label}</dt></div>)}
      </dl>
    </section>
  )}

  <!-- ================= SERVICES: two full-width panels ================= -->
  <div class="space-y-3 px-3">
    {[first, second].map((s, i) => (
      <section class:list={['rounded-[1.75rem] py-20 text-center sm:py-28', i === 0 ? 'bg-grey' : 'on-dark bg-night']}>
        <div class="container-x rise">
          <p class:list={['text-lg font-semibold sm:text-xl', i === 0 ? 'text-muted' : 'text-dim']}>{s.data.title}</p>
          <h2 class="title mx-auto mt-3 max-w-3xl">{s.data.headline}</h2>
          <p class:list={['mx-auto mt-5 max-w-2xl text-lg sm:text-xl', i === 0 ? 'text-muted' : 'text-dim']}>{s.data.summary}</p>
          <div class="mt-8 flex items-center justify-center gap-8">
            <a href={`/services/${s.id}`} class="more">Learn more ›</a>
            <a href="/contact" class="more">Talk to us ›</a>
          </div>
          <ul class:list={['mx-auto mt-14 flex max-w-3xl flex-wrap justify-center gap-x-8 gap-y-3 text-[0.95rem]', i === 0 ? 'text-ink/80' : 'text-dim']}>
            {s.data.capabilities.map((c) => <li>{c.name}</li>)}
          </ul>
        </div>
      </section>
    ))}

    <!-- ================= SERVICES: two-by-two grid ================= -->
    <div class="grid gap-3 lg:grid-cols-2">
      {rest.map((s, i) => (
        <section class:list={['flex flex-col rounded-[1.75rem] px-6 py-16 text-center sm:py-20', gridTone[i] === 'dark' ? 'on-dark bg-night' : 'bg-grey']}>
          <div class="rise">
            <p class:list={['text-lg font-semibold', gridTone[i] === 'dark' ? 'text-dim' : 'text-muted']}>{s.data.title}</p>
            <h2 class="mx-auto mt-3 max-w-md text-[1.75rem] font-semibold leading-tight tracking-tight sm:text-[2.5rem]">{s.data.headline}</h2>
            <p class:list={['mx-auto mt-4 max-w-md text-lg', gridTone[i] === 'dark' ? 'text-dim' : 'text-muted']}>{s.data.menuText}.</p>
            <div class="mt-7 flex items-center justify-center gap-8">
              <a href={`/services/${s.id}`} class="more">Learn more ›</a>
              <a href="/contact" class="more">Talk to us ›</a>
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>

  <!-- ================= HOW WE WORK ================= -->
  <section class="py-24 sm:py-32" aria-labelledby="how-h">
    <div class="container-x">
      <div class="rise text-center">
        <h2 id="how-h" class="title">How we work with you.</h2>
        <p class="subtitle mx-auto mt-5 max-w-2xl">Every engagement starts with a clear plan. You’ll know the scope, timeline and cost before the build begins.</p>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {stages.map((s, i) => (
          <li class="rise border-t-2 border-blue pt-5">
            <p class="text-sm text-muted">Step {i + 1}</p>
            <h3 class="mt-1 text-2xl">{s.name}</h3>
            <p class="mt-3 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-14 text-center"><a href="/how-it-works" class="more">More about our approach ›</a></p>
    </div>
  </section>

  <!-- ================= ENGAGEMENT MODELS ================= -->
  <section class="px-3" aria-labelledby="models-h">
    <div class="on-dark rounded-[1.75rem] bg-night py-24 sm:py-32">
      <div class="container-x">
        <div class="rise text-center">
          <h2 id="models-h" class="title">Ways to work with us.</h2>
          <p class="mx-auto mt-5 max-w-2xl text-xl text-dim sm:text-2xl">Choose the arrangement that fits the work, or combine them as your needs change.</p>
        </div>
        <ul class="mt-16 grid gap-3 md:grid-cols-3">
          {models.map((m) => (
            <li class="rise rounded-2xl bg-night-2 p-8">
              <h3 class="text-2xl">{m.name}</h3>
              <p class="mt-3 text-dim">{m.text}</p>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center text-dim">Flexible payment options are available, including financing over {pricing.financeYears} years for qualifying projects.</p>
      </div>
    </div>
  </section>

  <!-- ================= CLIENT FEEDBACK ================= -->
  {shownTestimonials.length > 0 && (
    <section class="py-24 sm:py-32" aria-labelledby="proof-h">
      <div class="container-x">
        <h2 id="proof-h" class="title rise text-center">What clients say.</h2>
        <div class="mt-14 grid gap-12 md:grid-cols-2">
          {shownTestimonials.map((t) => (
            <figure class="rise">
              <blockquote class="text-xl leading-relaxed sm:text-2xl">“{t.quote}”</blockquote>
              <figcaption class="mt-5 text-muted">{t.name ? <>{t.name}{t.role && <>, {t.role}</>}</> : 'Advica client'}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ================= INSIGHTS ================= -->
  <section class="border-t border-line py-24 sm:py-28" aria-labelledby="insights-h">
    <div class="container-wide">
      <div class="flex items-end justify-between gap-6 px-3">
        <h2 id="insights-h" class="title">Insights.</h2>
        <a href="/insights" class="more">See all ›</a>
      </div>
      <ul class="mt-10 grid gap-3 md:grid-cols-3">
        {posts.map((p) => (
          <li>
            <a href={`/insights/${p.id}`} class="group flex h-full flex-col rounded-[1.25rem] bg-grey p-8 transition-colors hover:bg-[#e3e8ef]">
              <span class="text-sm text-muted">{p.data.category}</span>
              <span class="mt-3 text-xl font-semibold leading-snug group-hover:text-blue">{p.data.title}</span>
              <span class="mt-auto pt-8 text-sm text-muted"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
