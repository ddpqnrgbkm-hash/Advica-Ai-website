---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies', (c) => !c.data.draft);
  return studies.map((c) => ({ params: { slug: c.id }, props: { study: c } }));
}
const { study } = Astro.props as { study: CollectionEntry<'caseStudies'> };
const { Content } = await render(study);
const d = study.data;
const services = await getCollection('services');
const service = services.find((s) => s.id === d.service);
---
<BaseLayout title={d.title} description={d.summary} type="article">
  <PageHero eyebrow={`Case study · ${d.industry}`} title={d.title} intro={d.summary} crumbs={[{ label: 'Case Studies', href: '/case-studies' }, { label: d.client }]} />

  <section class="py-16 sm:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_20rem]">
      <div class="prose prose-lg prose-invert max-w-none prose-headings:text-white prose-p:text-white/80 prose-li:text-white/80 prose-a:text-sky">
        <Content />
      </div>
      <aside class="space-y-4 lg:sticky lg:top-28 lg:self-start">
        <dl class="glass space-y-4 p-6 text-sm">
          <div><dt class="text-mist">Client</dt><dd class="font-medium text-white">{d.client}</dd></div>
          <div><dt class="text-mist">Industry</dt><dd class="font-medium text-white">{d.industry}</dd></div>
          {service && <div><dt class="text-mist">Service</dt><dd><a class="link" href={`/services/${service.id}`}>{service.data.title}</a></dd></div>}
        </dl>
        {d.results.length > 0 && (
          <div class="rounded-2xl border border-sky/30 bg-sky/[0.07] p-6">
            <h2 class="text-lg font-semibold text-white">Results</h2>
            <ul class="mt-3 space-y-2 text-white/90">{d.results.map((r) => <li>• {r}</li>)}</ul>
          </div>
        )}
      </aside>
    </div>
    {d.quote && (
      <figure class="container-x mt-16">
        <blockquote class="text-shine max-w-4xl text-2xl font-semibold leading-snug sm:text-3xl">“{d.quote.text}”</blockquote>
        <figcaption class="mt-4 text-mist"><span class="font-semibold text-white">{d.quote.name}</span>, {d.quote.role}</figcaption>
      </figure>
    )}
  </section>

  <CtaBand />
</BaseLayout>
