---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookButton from '../components/BookButton.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { steps } from '../data/steps';
import { pricing } from '../config/site';

const gbp = (n: number) => '£' + n.toLocaleString('en-GB');

const detail = [
  {
    get: ['An honest view of whether we can help', 'Rough options and next steps', 'No cost, no obligation'],
    note: 'Book online or call us. Bring the problem — you don’t need a specification.',
  },
  {
    get: ['Technical design of the whole system, including the data it needs', 'Wireframes and workflow maps so you can see how it will work', 'A clear roadmap with milestones, timeline and a fixed price for the build'],
    note: `Sprint 0 costs ${gbp(pricing.sprintZeroPrice)}. If you go ahead with the build with us, ${gbp(pricing.sprintZeroCredit)} is credited back against your build invoice.`,
  },
  {
    get: ['Working software delivered in short stages', 'Regular demos so you can give feedback early', 'Testing throughout, including security and performance'],
    note: 'You’ll have a named point of contact and a shared channel for day-to-day questions.',
  },
  {
    get: ['Launch, with your team trained', 'Either full handover with documentation…', '…or ongoing support, monitoring and improvements'],
    note: 'You choose. Plenty of clients start with support and take things in-house later.',
  },
];

const faqs = [
  { q: 'What do I need to prepare before we start?', a: 'Just your idea or the problem you want solved. You don’t need every technical detail — working out the scope, design and technical plan is exactly what Sprint 0 is for.' },
  { q: 'Do I have to do Sprint 0?', a: 'For most new builds, yes — it’s how we give you a fixed price you can rely on. For smaller pieces of work or extra engineers we may be able to quote directly; we’ll tell you on the discovery call.' },
  { q: 'What does starting a project involve?', a: 'Once you’re ready to go ahead, we complete a short onboarding form and our service agreement, take an agreed deposit, then schedule a kick-off call and get started.' },
  { q: 'How do we communicate during the project?', a: 'You get a named point of contact, a shared channel for quick questions and regular demos, so you always know how the build is progressing.' },
  { q: 'Who actually builds the software?', a: 'Advica scopes, plans and manages your project and remains your point of contact. The engineering is carried out by our established delivery partner’s specialist engineers, working to the plan agreed in Sprint 0.' },
];
---
<BaseLayout
  title="How it works — from discovery call to launch"
  description="Our four-step process: free discovery call, Sprint 0 plan with a fixed price, build in stages with regular demos, then handover or ongoing support."
  jsonLd={[{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}
>
  <PageHero
    eyebrow="How it works"
    title="Four steps. A fixed plan. No surprises."
    intro="We don’t start building until you know exactly what you’re getting, how long it will take and what it will cost."
    crumbs={[{ label: 'How It Works' }]}
  />

  <section class="py-20 sm:py-24">
    <ol class="container-x space-y-6">
      {steps.map((s, i) => (
        <li class="grid gap-8 rounded-3xl border border-line bg-white p-8 sm:p-12 lg:grid-cols-[auto_1fr_1fr]">
          <span class:list={['grid size-16 place-items-center rounded-2xl font-display text-2xl font-bold', ['bg-sky', 'bg-lime', 'bg-lilac', 'bg-brand text-white'][i]]}>{i + 1}</span>
          <div>
            <h2 class="text-3xl font-bold">{s.name}</h2>
            <p class="mt-1 font-medium text-brand">{s.short}</p>
            <p class="mt-4 text-lg leading-relaxed text-muted">{s.text}</p>
          </div>
          <div class="rounded-2xl bg-paper p-6">
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">What you get</h3>
            <ul class="mt-4 space-y-3">
              {detail[i].get.map((g) => (
                <li class="flex gap-3"><svg class="mt-0.5 size-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>{g}</li>
              ))}
            </ul>
            <p class="mt-5 border-t border-line pt-4 text-sm text-muted">{detail[i].note}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="container-x mt-10 flex flex-col gap-3 sm:flex-row">
      <BookButton class="btn-primary" label="Start with a free call" />
      <a href="/pricing" class="btn-secondary">See pricing</a>
    </div>
  </section>

  <section class="border-t border-line bg-white py-20 sm:py-24" aria-labelledby="faq-h">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h" class="mt-4 text-3xl font-bold sm:text-4xl">Questions about the process</h2>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
