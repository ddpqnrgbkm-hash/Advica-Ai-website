---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const guide = [
  { need: 'You want to use AI, automate admin or make sense of your data', go: 'ai-and-data' },
  { need: 'You need a new app, portal or system — or a better cloud setup', go: 'software-and-cloud' },
  { need: 'You already have a tech team and need more skilled people', go: 'extra-engineers' },
];
const title = (id: string) => services.find((s) => s.id === id)?.data.title;
---
<BaseLayout
  title="Services — AI, software, cloud and extra engineers"
  description="Bespoke AI and data, custom software and cloud, and embedded engineers for UK SMEs and mid-market businesses. See what we do and find the right fit."
>
  <PageHero
    eyebrow="Services"
    title="Everything you need to build with AI and software."
    intro="Three ways we help UK businesses — from a single AI tool to a full product build or extra engineers for your team."
    crumbs={[{ label: 'Services' }]}
  />

  <section class="py-20 sm:py-28" aria-label="Our services">
    <div class="container-x space-y-6">
      {services.map((s, i) => (
        <article class="reveal glass relative grid overflow-hidden lg:grid-cols-[1fr_1.25fr]">
          <div aria-hidden="true" class="absolute -left-20 -top-20 size-80 rounded-full bg-brand/20 blur-3xl"></div>
          <div class="relative flex flex-col p-8 sm:p-12">
            <span class="font-mono text-sm text-sky">0{i + 1}</span>
            <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">{s.data.title}</h2>
            <p class="mt-4 text-lg leading-relaxed text-mist">{s.data.summary}</p>
            <div class="mt-auto pt-10">
              <a href={`/services/${s.id}`} class="btn-primary">Explore {s.data.title} <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <ul class="relative divide-y divide-white/[0.06] border-t border-white/[0.06] lg:border-l lg:border-t-0">
            {s.data.capabilities.map((c) => (
              <li>
                <a href={`/services/${s.id}#${c.id}`} class="group flex items-center justify-between gap-4 px-8 py-5 transition hover:bg-white/[0.03]">
                  <span>
                    <span class="block font-medium text-white group-hover:text-sky">{c.name}</span>
                    <span class="mt-1 block font-mono text-[0.7rem] uppercase tracking-[0.12em] text-mist">{c.tags.slice(0, 3).join(' · ')}</span>
                  </span>
                  <span aria-hidden="true" class="text-sky transition-transform group-hover:translate-x-1">→</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-white/[0.06] bg-ink py-20 sm:py-28" aria-labelledby="guide-h">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.5fr]">
      <div class="reveal">
        <p class="eyebrow">Not sure?</p>
        <h2 id="guide-h" class="mt-5 text-4xl font-semibold text-white">Which one is right for me?</h2>
        <p class="mt-5 text-mist">Most businesses fit one of these. If yours doesn’t, that’s exactly what the discovery call is for.</p>
        <BookButton class="btn-primary mt-8" label="Talk it through" />
      </div>
      <ul class="space-y-3">
        {guide.map((g) => (
          <li class="reveal">
            <a href={`/services/${g.go}`} class="glow-card glass group flex flex-col gap-3 p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <span class="text-lg text-white/90">{g.need}</span>
              <span class="shrink-0 font-medium text-sky">{title(g.go)} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
