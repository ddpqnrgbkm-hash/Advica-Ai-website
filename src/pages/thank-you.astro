---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/BookButton.astro';
---
<BaseLayout title="Thank you" description="Thanks for getting in touch with Advica AI Solutions." noindex>
  <section class="on-dark bg-ink py-24 text-white sm:py-32">
    <div class="container-x max-w-3xl text-center">
      <span class="mx-auto grid size-16 place-items-center rounded-full bg-lime text-3xl text-ink" aria-hidden="true">✓</span>
      <h1 class="mt-8 text-4xl font-bold sm:text-6xl">Thanks — we’ve got your message.</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-white/75">One of the team will be in touch soon. If it’s urgent, give us a call. Want to skip the wait? Book a call now.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <BookButton class="btn bg-sky text-ink hover:bg-white" />
        <a href="/insights" class="btn-secondary">Read our insights</a>
      </div>
    </div>
  </section>
</BaseLayout>
