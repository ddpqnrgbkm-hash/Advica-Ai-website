---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';

const values = [
  { title: 'Clarity', text: 'Plain English, clear plans and no technical noise, so you can focus on the business result.' },
  { title: 'Speed', text: 'A fixed plan up front means the build can move quickly, without nasty surprises.' },
  { title: 'Honesty', text: 'If something isn’t worth building, or isn’t right for AI, we’ll tell you.' },
];

const partnerModels = [
  { title: 'Referral & alliance partners', text: 'For consultancies, agencies and advisers whose clients need AI or software expertise you don’t offer in-house. Bring us in alongside your own work.' },
  { title: 'Engineering capacity', text: 'For technology firms and in-house teams who need skilled engineers added to existing projects to hit deadlines or fill skill gaps.' },
  { title: 'Long-term transformation', text: 'For organisations wanting a partner alongside their leadership team, shaping the roadmap, building AI tools and putting good data practices in place.' },
];
const lookFor = [
  { title: 'Sound engineering', text: 'A shared commitment to secure, reliable, well-built technology.' },
  { title: 'Clear objectives', text: 'A focus on measurable business results, not experiments for their own sake.' },
  { title: 'Openness', text: 'Honest, transparent working relationships where knowledge is shared.' },
];
---
<BaseLayout
  title="About us: our mission, approach and partnerships"
  description="Advica AI Solutions helps UK businesses bring AI and custom software into day-to-day operations with clarity, speed and honesty. Learn how we work and partner with us."
>
  <PageHero eyebrow="About Advica" title="AI shouldn’t feel like a bottleneck." intro="Our mission is to bring simplicity, clarity and speed to UK businesses bringing AI and modern software into their day-to-day operations." crumbs={[{ label: 'About' }]} />

  <!-- Approach -->
  <section class="py-20 sm:py-28" aria-labelledby="approach-h">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-h" class="mt-5 text-4xl font-semibold leading-tight text-white sm:text-5xl">A UK partner who owns the outcome.</h2>
      </div>
      <div class="reveal space-y-5 text-lg leading-relaxed text-mist">
        <p>Many businesses know AI and better software could help, but find the technology world confusing and hard to trust. We sit on your side of the table.</p>
        <p>We start by understanding how your business really works, then design a plan with a fixed price before anything is built. Delivery is carried out by our established engineering partner’s specialist teams, while we stay your single point of contact, managing the project, keeping you informed and making sure what’s delivered matches what was agreed.</p>
        <p>When the work is done, you choose: we hand it over to your team, or keep supporting it for you.</p>
      </div>
    </div>
    <ul class="container-x mt-16 grid gap-5 md:grid-cols-3">
      {values.map((v, i) => (
        <li class="reveal glow-card glass relative overflow-hidden p-8">
          <div aria-hidden="true" class="absolute -right-10 -top-10 size-40 rounded-full bg-brand/25 blur-3xl"></div>
          <span class="relative font-mono text-sm text-sky">0{i + 1}</span>
          <h3 class="relative mt-6 text-3xl font-semibold text-white">{v.title}</h3>
          <p class="relative mt-3 text-mist">{v.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Company facts -->
  <section class="border-y border-white/[0.06] bg-ink py-16" aria-labelledby="facts-h">
    <div class="container-x">
      <h2 id="facts-h" class="font-mono text-xs uppercase tracking-[0.18em] text-sky">Company details</h2>
      <dl class="mt-8 grid gap-8 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div><dt class="text-mist">Registered name</dt><dd class="mt-1 text-base font-medium text-white">{site.legalName}</dd></div>
        {site.companyNumber && <div><dt class="text-mist">Company number</dt><dd class="mt-1 text-base font-medium text-white">{site.companyNumber} ({site.registeredIn})</dd></div>}
        <div><dt class="text-mist">Registered office</dt><dd class="mt-1 text-base font-medium text-white">{site.address.street}, {site.address.town} {site.address.postcode}</dd></div>
        <div><dt class="text-mist">Data protection</dt><dd class="mt-1 text-base font-medium text-white">Registered with the ICO{site.icoNumber && <> ({site.icoNumber})</>}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Partnerships -->
  <section id="partnerships" class="on-dark relative overflow-hidden py-20 sm:py-28" aria-labelledby="partner-h">
    <div aria-hidden="true" class="absolute -right-40 top-20 -z-10 h-[30rem] w-[30rem] rounded-full bg-brand/25 blur-[130px]"></div>
    <div class="container-x">
      <div class="reveal">
        <p class="eyebrow">Partnerships</p>
        <h2 id="partner-h" class="mt-5 max-w-3xl text-4xl font-semibold text-white sm:text-5xl">Let’s build something together.</h2>
        <p class="mt-6 max-w-2xl text-lg text-mist">Great results rarely come from one company working alone. We partner with organisations that care about good engineering and real business outcomes.</p>
      </div>

      <h3 class="mt-16 font-mono text-xs uppercase tracking-[0.18em] text-mist">Ways to partner</h3>
      <ul class="mt-6 grid gap-5 md:grid-cols-3">
        {partnerModels.map((m, i) => (
          <li class="reveal glow-card glass p-8">
            <span class="grid size-11 place-items-center rounded-xl border border-sky/30 bg-sky/10 font-mono text-sm text-sky">0{i + 1}</span>
            <h4 class="mt-6 text-xl font-semibold text-white">{m.title}</h4>
            <p class="mt-3 text-mist">{m.text}</p>
          </li>
        ))}
      </ul>

      <h3 class="mt-16 font-mono text-xs uppercase tracking-[0.18em] text-mist">What we look for</h3>
      <ul class="mt-6 grid gap-8 md:grid-cols-3">
        {lookFor.map((l) => (
          <li class="reveal border-t border-sky/30 pt-5">
            <h4 class="text-lg font-semibold text-white">{l.title}</h4>
            <p class="mt-2 text-mist">{l.text}</p>
          </li>
        ))}
      </ul>

      <div class="mt-14 flex flex-col gap-3 sm:flex-row">
        <a href="/contact?type=partnership" class="btn-primary">Discuss a partnership</a>
        <BookButton class="btn-secondary" label="Book a call" />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
