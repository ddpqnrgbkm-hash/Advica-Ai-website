---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookButton from '../components/BookButton.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing } from '../config/site';

const gbp = (n: number) => '£' + n.toLocaleString('en-GB');

const faqs = [
  { q: 'Why don’t you publish fixed prices for builds?', a: 'Every project is different, and a price without a plan is a guess. Sprint 0 gives you a fixed price based on a proper design. For a rough idea before then, try our project cost estimator.' },
  { q: 'Is the Sprint 0 credit guaranteed?', a: `If you go ahead with the build with us, ${gbp(pricing.sprintZeroCredit)} of your Sprint 0 fee is credited against your build invoice.` },
  { q: 'Who provides the monthly financing?', a: 'Independent technology finance providers we work with. They make their own lending decisions and agreements are between you and them.' },
  { q: 'Are there tax benefits to financing?', a: 'Spreading the cost can have tax advantages for some businesses, but it depends on your circumstances. Please speak to your accountant before deciding — we can’t give tax advice.' },
  { q: 'How are extra engineers priced?', a: 'Usually a monthly or day rate per engineer, depending on skills and seniority. We’ll give you a clear quote before anyone starts.' },
];
---
<BaseLayout
  title="Pricing — Sprint 0, milestone billing and monthly financing"
  description={`Start with Sprint 0 (${gbp(pricing.sprintZeroPrice)}, with ${gbp(pricing.sprintZeroCredit)} credited if you build with us), then pay by milestone or spread the cost monthly over ${pricing.financeYears} years.`}
  jsonLd={[{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}
>
  <PageHero
    eyebrow="Pricing"
    title="Clear pricing. Flexible ways to pay."
    intro="Start with a fixed-price plan, then choose how you pay for the build — in stages, or spread monthly so your cash stays free for running the business."
    crumbs={[{ label: 'Pricing' }]}
  />

  <!-- Sprint 0 -->
  <section class="py-20 sm:py-24" aria-labelledby="s0-h">
    <div class="container-x grid overflow-hidden rounded-3xl border border-line bg-white lg:grid-cols-[1fr_1.2fr]">
      <div class="flex flex-col bg-sky p-8 sm:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ink/70">Step 1 · Discovery phase</p>
        <h2 id="s0-h" class="mt-3 text-4xl font-bold">Sprint 0</h2>
        <p class="mt-8 font-display text-6xl font-bold">{gbp(pricing.sprintZeroPrice)}</p>
        <p class="mt-3 text-lg font-semibold">{gbp(pricing.sprintZeroCredit)} credited back when you build with us</p>
        {pricing.vatNote && <p class="mt-2 text-sm text-ink/70">{pricing.vatNote}</p>}
        <div class="mt-auto pt-10"><BookButton class="btn bg-ink text-white hover:bg-ink-2" label="Discuss Sprint 0" /></div>
      </div>
      <div class="p-8 sm:p-12">
        <p class="text-lg text-muted">Before any build begins, we work with you to design, scope and plan your whole project, so it’s based on real business needs and you know exactly what you’re paying for.</p>
        <h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-muted">You get</h3>
        <ul class="mt-4 space-y-5">
          {[
            ['Technical design and data plan', 'A full map of how the system works, the data it needs and where it runs.'],
            ['Wireframes and workflow maps', 'Visual guides to every screen and process, so there are no surprises.'],
            ['A fixed roadmap and price', 'Milestones, timeline and a fixed price for the build.'],
          ].map(([t, x]) => (
            <li class="flex gap-4">
              <svg class="mt-1 size-6 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span><span class="block font-semibold">{t}</span><span class="text-muted">{x}</span></span>
            </li>
          ))}
        </ul>
        <p class="mt-8 rounded-2xl bg-paper p-5 text-sm text-muted">Not sure you need Sprint 0? The <a class="link" href="/how-it-works">free discovery call</a> comes first, and we’ll tell you honestly.</p>
      </div>
    </div>
  </section>

  <!-- Ways to pay -->
  <section class="border-y border-line bg-white py-20 sm:py-24" aria-labelledby="pay-h">
    <div class="container-x">
      <p class="eyebrow">Step 2 · Paying for the build</p>
      <h2 id="pay-h" class="mt-4 text-4xl font-bold sm:text-5xl">Two ways to pay</h2>
      <div class="mt-12 grid gap-4 lg:grid-cols-2">
        <article class="flex flex-col rounded-3xl border border-line p-8 sm:p-10">
          <h3 class="text-3xl font-bold">Milestone billing</h3>
          <p class="mt-3 text-lg text-muted">Pay in stages as agreed milestones are delivered.</p>
          <ul class="mt-8 space-y-3">
            {['A deposit to start, then payments tied to delivery', 'Simple and predictable', 'You only pay for what’s been delivered'].map((t) => (
              <li class="flex gap-3"><span class="text-brand" aria-hidden="true">●</span>{t}</li>
            ))}
          </ul>
          <p class="mt-8 text-sm text-muted">Best for: businesses with budget set aside for the project.</p>
        </article>
        <article class="on-dark flex flex-col rounded-3xl bg-ink p-8 text-white sm:p-10">
          <h3 class="text-3xl font-bold">Monthly financing</h3>
          <p class="mt-3 text-lg text-white/75">Spread the cost over {pricing.financeYears} years through independent finance partners.</p>
          <ul class="mt-8 space-y-3">
            {['Keep cash free for hiring, stock and growth', 'Start now rather than waiting for next year’s budget', 'Predictable monthly payments'].map((t) => (
              <li class="flex gap-3"><span class="text-sky" aria-hidden="true">●</span>{t}</li>
            ))}
          </ul>
          <div class="mt-8 rounded-2xl bg-white/5 p-5 text-sm text-mist">
            <p class="font-semibold text-white">Eligibility</p>
            <p class="mt-1">Subject to the finance provider’s approval and checks. Typically your business needs at least 3 years’ trading history and to have completed Sprint 0.</p>
            <p class="mt-3 font-semibold text-white">Tax</p>
            <p class="mt-1">Financing may offer tax advantages for some businesses. Please consult your accountant — we can’t give tax advice.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Estimator CTA -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <a href="/estimate" class="group flex flex-col justify-between gap-6 rounded-3xl bg-brand p-8 text-white sm:flex-row sm:items-center sm:p-12">
        <span>
          <span class="block font-display text-3xl font-bold">Want a rough idea first?</span>
          <span class="mt-2 block text-white/80">Answer five quick questions for an indicative estimate.</span>
        </span>
        <span class="btn shrink-0 bg-white text-ink">Try the estimator <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="border-t border-line bg-white py-20 sm:py-24" aria-labelledby="faq-h">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-h" class="mt-4 text-3xl font-bold sm:text-4xl">Pricing questions</h2>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
