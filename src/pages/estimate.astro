---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ChoiceStep from '../components/ChoiceStep.astro';
import StepNav from '../components/StepNav.astro';
import BookButton from '../components/BookButton.astro';
import { estimator, pricing } from '../config/site';
import { estimatorQuestions } from '../data/estimator-questions';

const field = 'mt-2 block w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-base focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30';
const config = { estimator, pricing };
---
<BaseLayout
  title="Project cost estimator"
  description="Answer five quick questions to see the likely size of your AI or software project and the best next step. Free, no sign-up needed."
>
  <PageHero eyebrow="Free tool · 2 minutes" title="What might my project cost?" intro="Answer five quick questions. We’ll show you the likely size of your project and the best next step — no sign-up needed." crumbs={[{ label: 'Cost estimator' }]} />

  <section class="py-16 sm:py-20">
    <div class="container-x max-w-3xl">
      <form
        id="estimator"
        data-stepper
        data-default-path="build"
        name="estimate"
        method="POST"
        action="/thank-you"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="card space-y-10 sm:p-12"
      >
        <input type="hidden" name="form-name" value="estimate" />
        <input type="hidden" name="result" value="" />
        <p class="hidden"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        {estimatorQuestions.map((q) => (
          <ChoiceStep
            name={q.id}
            question={q.question}
            help={q.help}
            path={q.path}
            options={q.options.map((o) => ({ label: o.label, points: o.points, choosePath: o.path }))}
          />
        ))}

        <StepNav />

        <!-- Result (filled in by the script below) -->
        <div data-after hidden aria-live="polite">
          <p class="eyebrow">Your result</p>
          <h2 data-focus tabindex="-1" class="mt-3 font-display text-3xl font-bold outline-none sm:text-4xl" id="est-title"></h2>
          <p class="mt-3 text-lg text-muted" id="est-text"></p>
          <p class="mt-6 font-display text-4xl font-bold text-brand" id="est-price" hidden></p>
          <div class="mt-8 rounded-2xl bg-sky p-6" id="est-next"></div>
          <p class="mt-4 text-sm text-muted">This is an indicative guide, not a quote. Every project is different — a fixed price comes after Sprint 0.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <BookButton class="btn-primary" label="Book a free call" />
            <button type="button" data-restart class="btn-secondary">Start again</button>
          </div>
        </div>

        <!-- Contact details -->
        <div data-after class="border-t border-line pt-10">
          <h2 class="font-display text-2xl font-bold">Want a proper conversation about it?</h2>
          <p class="mt-2 text-muted">Leave your details and we’ll get back to you to talk it through. Your answers above are included automatically.</p>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="e-name" class="block text-sm font-semibold">Your name <span class="text-brand" aria-hidden="true">*</span></label>
              <input id="e-name" name="name" required autocomplete="name" class={field} />
            </div>
            <div>
              <label for="e-email" class="block text-sm font-semibold">Email <span class="text-brand" aria-hidden="true">*</span></label>
              <input id="e-email" name="email" type="email" required autocomplete="email" class={field} />
            </div>
            <div>
              <label for="e-company" class="block text-sm font-semibold">Company</label>
              <input id="e-company" name="company" autocomplete="organization" class={field} />
            </div>
            <div>
              <label for="e-phone" class="block text-sm font-semibold">Phone <span class="font-normal text-muted">(optional)</span></label>
              <input id="e-phone" name="phone" type="tel" autocomplete="tel" class={field} />
            </div>
            <div class="sm:col-span-2">
              <label for="e-message" class="block text-sm font-semibold">Anything else we should know? <span class="font-normal text-muted">(optional)</span></label>
              <textarea id="e-message" name="message" rows="4" class={field}></textarea>
            </div>
          </div>
          <p class="mt-4 text-sm text-muted">We’ll only use your details to reply. See our <a class="link" href="/privacy">privacy policy</a>.</p>
          <button type="submit" class="btn-primary mt-6">Send my details</button>
        </div>
      </form>
    </div>
  </section>

  <script type="application/json" id="estimator-config" set:html={JSON.stringify(config)} />
</BaseLayout>

<script>
  import { initStepper } from '../scripts/stepper';
  import { sizeFor } from '../data/estimator-questions';

  const form = document.getElementById('estimator') as HTMLFormElement;
  const { estimator, pricing } = JSON.parse(document.getElementById('estimator-config')!.textContent!);
  const gbp = (n: number) => '£' + Number(n).toLocaleString('en-GB');
  const $ = (id: string) => document.getElementById(id)!;

  initStepper(form);

  form.addEventListener('stepper:done', () => {
    const checked = [...form.querySelectorAll<HTMLInputElement>('fieldset:not([disabled]) input:checked')];
    const engineers = checked.some((i) => i.dataset.choosePath === 'engineers');
    const price = $('est-price');
    let summary = '';

    if (engineers) {
      const get = (n: string) => (form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value ?? '').toLowerCase();
      $('est-title').textContent = 'Extra engineers for your team';
      $('est-text').textContent = `You’re looking for ${get('engineers')} (${get('skills')}), for ${get('duration')}. Engineers are usually priced at a monthly rate per person, depending on skills and seniority.`;
      const m = estimator.engineerMonthly;
      price.hidden = !(estimator.showPrices && m.max > 0);
      price.textContent = `${gbp(m.min)} – ${gbp(m.max)} per engineer per month`;
      $('est-next').innerHTML = '<p class="font-semibold">Recommended next step</p><p class="mt-1">A free discovery call to agree the skills you need. We’ll then give you a clear quote — no Sprint 0 needed.</p>';
      summary = `Extra engineers: ${get('engineers')}, ${get('skills')}, ${get('duration')}`;
    } else {
      const points = checked.reduce((t, i) => t + Number(i.dataset.points || 0), 0);
      const size = estimator.sizes[sizeFor(points)];
      $('est-title').textContent = `This looks like a ${size.label.toLowerCase()} project`;
      $('est-text').textContent = `${size.example}.`;
      price.hidden = !(estimator.showPrices && size.max > 0);
      price.textContent = `Indicative build cost: ${gbp(size.min)} – ${gbp(size.max)}`;
      $('est-next').innerHTML = `<p class="font-semibold">Recommended next step: Sprint 0</p><p class="mt-1">A ${gbp(pricing.sprintZeroPrice)} discovery phase that gives you a full design and a fixed price for the build. ${gbp(pricing.sprintZeroCredit)} is credited back if you build with us. Prefer to spread the build cost? <a class="underline" href="/pricing">Monthly financing</a> is available to eligible businesses.</p>`;
      summary = `${size.label} project (${points} points)`;
    }
    (form.querySelector('input[name="result"]') as HTMLInputElement).value = summary;
  });
</script>
