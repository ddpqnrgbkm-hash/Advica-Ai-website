---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const [featured, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const tile = ['bg-sky', 'bg-lime', 'bg-lilac'];
---
<BaseLayout
  title="Insights — plain-English guides on AI and software"
  description="Practical, jargon-free articles on AI, automation, data and software for UK business owners and managers, from the Advica AI Solutions team."
>
  <PageHero eyebrow="Insights" title="Plain-English thinking on AI and software." intro="Practical articles for business owners and managers — what’s changing, what it means for you and what to do about it." crumbs={[{ label: 'Insights' }]} />

  <section class="py-20 sm:py-24">
    <div class="container-x">
      {featured && (
        <a href={`/insights/${featured.id}`} class="group grid overflow-hidden rounded-3xl border border-line bg-white lg:grid-cols-2">
          <div class="flex min-h-64 items-end bg-ink p-8 sm:p-12">
            <span class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl">{featured.data.title}</span>
          </div>
          <div class="flex flex-col p-8 sm:p-12">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand">Latest · {featured.data.category}</p>
            <p class="mt-4 text-lg text-muted">{featured.data.description}</p>
            <p class="mt-auto pt-8 text-sm text-muted"><time datetime={featured.data.date.toISOString()}>{fmt(featured.data.date)}</time>{featured.data.readingTime && <> · {featured.data.readingTime}</>}</p>
            <span class="mt-4 font-semibold text-brand group-hover:underline">Read article →</span>
          </div>
        </a>
      )}

      <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p, i) => (
          <li>
            <a href={`/insights/${p.id}`} class="group flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-white">
              <span class:list={['block px-7 py-5 text-sm font-semibold text-ink', tile[i % 3]]}>{p.data.category}</span>
              <span class="flex flex-1 flex-col p-7">
                <span class="font-display text-xl font-bold leading-snug group-hover:text-brand">{p.data.title}</span>
                <span class="mt-3 text-muted">{p.data.description}</span>
                <span class="mt-auto pt-6 text-sm text-muted"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>{p.data.readingTime && <> · {p.data.readingTime}</>}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
