---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const [featured, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="Insights — plain-English guides on AI and software"
  description="Practical, jargon-free articles on AI, automation, data and software for UK business owners and managers, from the Advica AI Solutions team."
>
  <PageHero eyebrow="Insights" title="Plain-English thinking on AI and software." intro="Practical articles for business owners and managers — what’s changing, what it means for you and what to do about it." crumbs={[{ label: 'Insights' }]} />

  <section class="py-20 sm:py-28">
    <div class="container-x">
      {featured && (
        <a href={`/insights/${featured.id}`} class="reveal glow-card glass group relative grid overflow-hidden lg:grid-cols-[1.2fr_1fr]">
          <div class="relative flex min-h-72 items-end overflow-hidden p-8 sm:p-12">
            <div aria-hidden="true" class="grid-bg absolute inset-0 [mask-image:linear-gradient(to_top,#000,transparent)]"></div>
            <div aria-hidden="true" class="absolute -left-10 -top-10 size-80 rounded-full bg-brand/35 blur-3xl"></div>
            <div aria-hidden="true" class="absolute bottom-0 right-10 size-56 rounded-full bg-sky/20 blur-3xl"></div>
            <span class="relative">
              <span class="font-mono text-xs uppercase tracking-[0.16em] text-sky">Latest · {featured.data.category}</span>
              <span class="mt-4 block text-3xl font-semibold leading-tight text-white group-hover:text-sky sm:text-4xl">{featured.data.title}</span>
            </span>
          </div>
          <div class="flex flex-col border-t border-white/[0.06] p-8 sm:p-12 lg:border-l lg:border-t-0">
            <p class="text-lg leading-relaxed text-mist">{featured.data.description}</p>
            <p class="mt-auto pt-8 font-mono text-xs uppercase tracking-[0.14em] text-mist"><time datetime={featured.data.date.toISOString()}>{fmt(featured.data.date)}</time>{featured.data.readingTime && <> · {featured.data.readingTime}</>}</p>
            <span class="mt-4 font-medium text-sky">Read article →</span>
          </div>
        </a>
      )}

      <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <li class="reveal">
            <a href={`/insights/${p.id}`} class="glow-card glass group flex h-full flex-col p-7">
              <span class="font-mono text-xs uppercase tracking-[0.16em] text-sky">{p.data.category}</span>
              <span class="mt-4 text-xl font-semibold leading-snug text-white group-hover:text-sky">{p.data.title}</span>
              <span class="mt-3 text-mist">{p.data.description}</span>
              <span class="mt-auto pt-6 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-mist"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>{p.data.readingTime && <> · {p.data.readingTime}</>}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
